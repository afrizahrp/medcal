# Production environment contract for @medcal/api AND @medcal/web-api (F5.3,
# extended for the full approved production topology — see
# docs/Architecture/02-foundation-implementation-plan.md §F5 and this
# session's containerization audits).
#
# This is a TEMPLATE — no real secrets. Copy to `.env.production` on the VPS
# (never commit that file) and fill in real values there. Do not reuse any
# development secret from `.env` in production.
#
# Deployed via docker-compose.prod.yml's `env_file: .env.production` on BOTH
# the api and web-api services (one shared file, deliberately — it's what
# guarantees INTERNAL_API_SECRET and CHAT_SESSION_TOKEN_SECRET stay
# byte-identical between the two services without a manual sync step). The
# NEXT_PUBLIC_* section further down is consumed differently: it's read by
# Compose's own variable substitution for the web/portal services' Docker
# BUILD ARGS (via `--env-file .env.production`, see docker-compose.prod.yml's
# top comment), not injected into any container's runtime environment.

# --- Database -----------------------------------------------------------
# Native PostgreSQL already runs on the VPS host (existing infrastructure,
# not managed by MedCal's Compose stack). From inside the apps/api container,
# reach it via the Docker bridge gateway, NOT "localhost" (localhost inside
# the container is the container itself).
#
# Prerequisite this file does NOT configure: the native PostgreSQL instance's
# listen_addresses/pg_hba.conf must permit connections from the Docker bridge
# network (typically 172.17.0.0/16) or from host.docker.internal. That is a
# change to existing native PostgreSQL config, which F5 deliberately does not
# make automatically (see F5 doc note — "do not modify native PostgreSQL
# config unless explicitly requested"). Confirm/perform it manually first.
DATABASE_URL="postgresql://<prod_user>:<prod_password>@host.docker.internal:5432/<prod_db>?schema=public"

# --- Company binding (ADR-000) ------------------------------------------
COMPANY_ID="PKM"

# --- Nest API (internal container port; only exposed to the host as 127.0.0.1:3001) ---
API_PORT=3001
API_URL="https://api.kalibrasimedika.co.id"

# --- Better Auth (hosted in-process in apps/api) -------------------------
# Generate a fresh secret for production — do NOT reuse the dev value from .env.
# e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET="<generate-a-new-production-secret>"
BETTER_AUTH_URL="https://api.kalibrasimedika.co.id"

# --- CORS / cookie scope --------------------------------------------------
# Real production subdomains only.
TRUSTED_ORIGINS="https://kalibrasimedika.co.id,https://apps.kalibrasimedika.co.id,https://portal.kalibrasimedika.co.id,https://technician.kalibrasimedika.co.id"
# Shared across apps.*/portal.*/technician.* — locked production value.
COOKIE_DOMAIN=".kalibrasimedika.co.id"

# --- Internal service trust (web-api -> apps/api) -------------------------
# Generate a real secret, do not reuse the dev placeholder. Must be
# byte-identical to the value apps/web-api uses — both containers read this
# same variable from this same file.
INTERNAL_API_SECRET="<generate-a-new-production-secret>"

# --- Web Chat: ChatSessionToken (signed by web-api, verified by apps/api at
# the Socket.IO handshake) — must be byte-identical between the two services,
# same reasoning as INTERNAL_API_SECRET above. Generate fresh, do not reuse
# the dev placeholder.
CHAT_SESSION_TOKEN_SECRET="<generate-a-new-production-secret>"
CHAT_SESSION_TOKEN_TTL_MS="2592000000"

NODE_ENV=production

# =========================================================================
# --- @medcal/web-api only (Express public edge, port 3002) ---------------
# =========================================================================
WEB_API_PORT=3002

# Credentialed CORS allowlist for POST /public/chat-sessions specifically
# (sets the ChatSessionToken cookie — needs an explicit origin, unlike the
# wildcard cors() used by web-api's other public routes). Left unset in
# production so it correctly falls through to TRUSTED_ORIGINS above, which
# already includes the real production web origin — do not duplicate it here
# unless a route ever needs a narrower allowlist than TRUSTED_ORIGINS.
CHAT_WIDGET_ORIGINS=""

# --- Contact Form bot protection (reCAPTCHA v3, verified server-side in
# apps/web-api — never trust a client-reported score). Site key is public
# (see apps/web's NEXT_PUBLIC_RECAPTCHA_SITE_KEY below); this secret key must
# never be committed with a real value.
RECAPTCHA_SECRET_KEY="<generate-or-obtain-a-real-production-recaptcha-secret-key>"
RECAPTCHA_MIN_SCORE="0.5"

# --- Per-route rate limits (apps/web-api) — each route has its own
# independent quota, none shared. Defaults below match the code's own
# fallback values; only override if production traffic patterns require it.
CONTACT_FORM_RATE_LIMIT_WINDOW_MS="60000"
CONTACT_FORM_RATE_LIMIT_MAX="5"
# Legacy one-shot /public/web-chat route (superseded by
# /public/chat-sessions's real-time flow, still live server-side — see the
# web-api build-readiness audit). Undocumented in any env file until now;
# code already has working defaults, listed here so a future
# deprecation/removal of the route is a visible, deliberate change.
WEB_CHAT_RATE_LIMIT_WINDOW_MS="60000"
WEB_CHAT_RATE_LIMIT_MAX="5"
CHAT_SESSION_RATE_LIMIT_WINDOW_MS="60000"
CHAT_SESSION_RATE_LIMIT_MAX="5"
WHATSAPP_LEAD_RATE_LIMIT_WINDOW_MS="60000"
WHATSAPP_LEAD_RATE_LIMIT_MAX="5"

# =========================================================================
# --- Next.js build-time variables (apps/web, apps/portal) ----------------
# =========================================================================
# NOT injected into any container's runtime environment — read only by
# Compose's variable substitution for docker-compose.prod.yml's web/portal
# `build.args`, and only actually consumed by `next build` itself (baked
# into the client bundle). See docker-compose.prod.yml's top comment for the
# --env-file requirement this depends on.

# apps/web: Socket.IO connection target (Web Chat) + apps/portal: Better Auth
# client baseURL / apiFetch base / management chat socket target.
NEXT_PUBLIC_API_URL="https://api.kalibrasimedika.co.id"

# apps/web only: Contact Form / WhatsApp lead / chat-session-creation target.
# BARE ORIGIN, no /public suffix — every call site in apps/web/src already
# appends "/public/..." itself (e.g. `${WEB_API_URL}/public/chat-sessions`,
# matching the dev default "http://localhost:3002" with no /public suffix
# either). Setting this to ".../public" would produce a double-path
# ".../public/public/chat-sessions" and break every lead-gen channel — do
# not "correct" this back to a /public suffix without also removing the
# "/public/..." prefix from every fetch() call site in apps/web/src.
# Path-routed through the same kalibrasimedika.co.id origin as apps/web
# itself (Nginx splits /public/* to web-api) — see
# infra/nginx/kalibrasimedika.co.id.conf.example.
NEXT_PUBLIC_WEB_API_URL="https://kalibrasimedika.co.id"

# apps/web only: reCAPTCHA v3 SITE key (public by Google's own design — the
# paired secret key is RECAPTCHA_SECRET_KEY above, never exposed to the
# browser). apps/portal has no reCAPTCHA usage anywhere in its source.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="<production-recaptcha-site-key>"
