# PostgreSQL
DATABASE_URL="postgresql://medcal:medcal@localhost:5432/medcal?schema=public"

# Public website company binding (ADR-000)
COMPANY_ID="change-me-company-cuid"

# Nest API — sole business layer: REST + WebSocket + Better Auth (locked: Better Auth hosted in-process in apps/api)
API_PORT=3001
API_URL="http://localhost:3001"

# Express public edge — zero DB access, forwards to Nest only
WEB_API_PORT=3002
WEB_API_URL="http://localhost:3002"
INTERNAL_API_SECRET="change-me-internal-secret"

# Next apps — apps/portal & apps/tech-pwa call apps/api directly; apps/web (public site) calls the web-api edge only
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WEB_API_URL="http://localhost:3002"

# Better Auth — hosted inside apps/api (NestJS), not a separate service; BETTER_AUTH_URL must match API_URL/API_PORT above.
# Development-only secret below — production uses its own secret, generated separately and never committed.
BETTER_AUTH_SECRET="change-me-better-auth-secret-dev-only"
BETTER_AUTH_URL="http://localhost:3001"

# Browser origins allowed to call apps/api with credentials (apps/web, apps/portal, apps/tech-pwa dev ports).
# Production: the real apps.*/portal.*/technician.* subdomains under kalibrasimedika.co.id.
TRUSTED_ORIGINS="http://localhost:3000,http://localhost:3003,http://localhost:3004"
# Unset for localhost dev (cookies scope to the exact host); ".kalibrasimedika.co.id" in production
# so the session cookie is shared across apps.*/portal.*/technician.* subdomains.
COOKIE_DOMAIN=""

# Push notifications use FCM (Firebase Admin SDK + device token), not Web Push/VAPID — provisioned via a Firebase/GCP
# service account at implementation time, not as env vars here. See Adoption Matrix, Notifications/FCM/PWA section.

# Optional: public origin for reverse-proxy setups (Host hygiene)
# __NEXT_PRIVATE_ORIGIN="https://www.example.com"
__NEXT_PRIVATE_ORIGIN=""
