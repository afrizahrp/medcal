# PROPOSED Nginx server block for apps.kalibrasimedika.co.id (apps/portal,
# Lead Management / internal management portal — management surface only in
# this pass; apps/portal's "portal." client-surface prefix is not deployed
# here, no DNS exists for it).
#
# NOT YET APPLIED. This file is a plan for the VPS operator to review and
# install manually — it is not wired into any deploy script, and nothing in
# this repo reloads or restarts the live Nginx instance.
#
# Existing Nginx routes this must NOT disturb:
#   bipmed.co.id / www.bipmed.co.id           -> localhost:3000
#   bumiindah.co.id / www.bumiindah.co.id     -> localhost:3100
#   apps.bumiindah.co.id                      -> localhost:5000
#   restweb.bumiindah.co.id                   -> localhost:7000
#   rest.bumiindah.co.id                      -> localhost:8000
# NOTE: bumiindah's existing "apps.bumiindah.co.id" and MedCal's new
# "apps.kalibrasimedika.co.id" are DIFFERENT server_names (different base
# domains) — Nginx disambiguates on the full server_name, so this does not
# collide with the existing apps.bumiindah.co.id block above. Confirmed no
# server_name conflict.
#
# apps/portal reads the incoming Host header itself (src/proxy.ts) to decide
# management-vs-client routing ("apps." prefix -> management, "portal."
# prefix -> client — unmodified per the approved topology). This means
# `proxy_set_header Host $host;` below is NOT just best practice here, it is
# LOAD-BEARING: without it, portal's own middleware would see the wrong host
# and misroute or 404. No WebSocket handling is needed on this hostname:
# portal's Socket.IO connection (management chat) goes straight from the
# browser to api.kalibrasimedika.co.id, never through this origin.
#
# Suggested install steps (manual, by the VPS operator, not automated here):
#   1. docker compose --env-file .env.production -f docker-compose.prod.yml up -d
#      (portal container must be running and healthy on 127.0.0.1:3003
#      BEFORE Nginx is pointed at it)
#   2. cp this file to /etc/nginx/sites-available/apps.kalibrasimedika.co.id.conf
#   3. ln -s /etc/nginx/sites-available/apps.kalibrasimedika.co.id.conf \
#            /etc/nginx/sites-enabled/apps.kalibrasimedika.co.id.conf
#   4. certbot --nginx -d apps.kalibrasimedika.co.id   (same Certbot flow
#      already used for the existing sites and for api.*/kalibrasimedika.co.id)
#   5. nginx -t   (validate BEFORE reloading)
#   6. systemctl reload nginx   (reload, not restart — does not drop existing
#      connections to bipmed/bumiindah/api.*/kalibrasimedika.co.id)

server {
    listen 80;
    listen [::]:80;
    server_name apps.kalibrasimedika.co.id;

    # Certbot's HTTP-01 challenge path.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name apps.kalibrasimedika.co.id;

    # Certbot fills these in when run with --nginx (step 4 above).
    ssl_certificate     /etc/letsencrypt/live/apps.kalibrasimedika.co.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/apps.kalibrasimedika.co.id/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3003;
        # LOAD-BEARING, not just best practice — see header note above.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
