# PROPOSED Nginx server block for api.kalibrasimedika.co.id (F5.5).
#
# NOT YET APPLIED. This file is a plan for the VPS operator to review and
# install manually — it is not wired into any deploy script, and nothing in
# this repo reloads or restarts the live Nginx instance.
#
# Existing Nginx routes this must NOT disturb:
#   bipmed.co.id / www.bipmed.co.id           -> localhost:3000
#   bumiindah.co.id / www.bumiindah.co.id     -> localhost:3100
#   apps.bumiindah.co.id                      -> localhost:5000
#   restweb.bumiindah.co.id                   -> localhost:7000
#   rest.bumiindah.co.id                      -> localhost:8000
#
# This block only adds a NEW server_name (api.kalibrasimedika.co.id) pointing
# at MedCal's apps/api container, published to 127.0.0.1:3001 by
# docker-compose.prod.yml. It does not modify any existing server block.
#
# Suggested install steps (manual, by the VPS operator, not automated here):
#   1. docker compose -f docker-compose.prod.yml up -d   (container must be running
#      and healthy on 127.0.0.1:3001 BEFORE Nginx is pointed at it)
#   2. cp this file to /etc/nginx/sites-available/api.kalibrasimedika.co.id.conf
#   3. ln -s /etc/nginx/sites-available/api.kalibrasimedika.co.id.conf \
#            /etc/nginx/sites-enabled/api.kalibrasimedika.co.id.conf
#   4. certbot --nginx -d api.kalibrasimedika.co.id   (same Certbot flow already
#      used for the existing sites; issues the cert and rewrites this block's
#      listen 443/ssl_certificate lines automatically, the same way it already
#      did for bipmed.co.id/bumiindah.co.id)
#   5. nginx -t   (validate BEFORE reloading)
#   6. systemctl reload nginx   (reload, not restart — does not drop existing
#      connections to bipmed/bumiindah)
#
# kalibrasimedika.co.id (apps/web + apps/web-api under /public/*) and
# apps.kalibrasimedika.co.id (apps/portal) now have their own equivalent
# blocks: infra/nginx/kalibrasimedika.co.id.conf.example and
# infra/nginx/apps.kalibrasimedika.co.id.conf.example. portal.* and
# technician.* are not part of the current approved topology — apps/portal
# is deployed under apps.* only in this pass (see apps/portal/src/proxy.ts's
# host-based routing, unmodified).

server {
    listen 80;
    listen [::]:80;
    server_name api.kalibrasimedika.co.id;

    # Certbot's HTTP-01 challenge path.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.kalibrasimedika.co.id;

    # Certbot fills these in when run with --nginx (step 4 above).
    ssl_certificate     /etc/letsencrypt/live/api.kalibrasimedika.co.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.kalibrasimedika.co.id/privkey.pem;

    # Generic file infrastructure (Phase 1): certificate/evidence PDF uploads
    # go to POST /files on apps/api. Nginx's default client_max_body_size is
    # 1 MB — too small for a scanned certificate. This must be >= the app's
    # own MAX_UPLOAD_BYTES (20 MiB, apps/api/src/modules/files/files.constants.ts).
    # It does NOT expose the storage directory: there is no static/file
    # location here, every byte still flows through the authenticated app.
    client_max_body_size 25m;

    # apps/api serves both REST and the Chat WebSocket gateway from the same
    # origin (locked topology) — Upgrade/Connection headers are required for
    # the WS path to work through the proxy, not just REST.
    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 75s;
    }
}
