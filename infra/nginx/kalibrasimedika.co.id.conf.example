# PROPOSED Nginx server block for kalibrasimedika.co.id.
#
# NOT YET APPLIED. This file is a plan for the VPS operator to review and
# install manually — it is not wired into any deploy script, and nothing in
# this repo reloads or restarts the live Nginx instance.
#
# Existing Nginx routes this must NOT disturb:
#   bipmed.co.id / www.bipmed.co.id           -> localhost:3000
#   bumiindah.co.id / www.bumiindah.co.id     -> localhost:3100
#   apps.bumiindah.co.id                      -> localhost:5000
#   restweb.bumiindah.co.id                   -> localhost:7000
#   rest.bumiindah.co.id                      -> localhost:8000
#
# This block adds a NEW server_name (kalibrasimedika.co.id) split between two
# MedCal containers by path, per the approved production topology:
#   location /            -> apps/web    (127.0.0.1:3000)
#   location /public/*    -> apps/web-api (127.0.0.1:3002)
# apps/web's own route tree (/, /layanan, /layanan/[kategori], /kontak,
# /sertifikasi-legalitas, /robots.txt, /sitemap.xml) has zero collision with
# the /public/ prefix — verified during the containerization forensic audit.
# No WebSocket handling is needed on this hostname: Web Chat's Socket.IO
# connection goes straight from the browser to api.kalibrasimedika.co.id
# (see that conf file), never through this origin or through web-api.
#
# Suggested install steps (manual, by the VPS operator, not automated here):
#   1. docker compose --env-file .env.production -f docker-compose.prod.yml up -d
#      (web and web-api containers must be running and healthy on
#      127.0.0.1:3000/127.0.0.1:3002 BEFORE Nginx is pointed at them)
#   2. cp this file to /etc/nginx/sites-available/kalibrasimedika.co.id.conf
#   3. ln -s /etc/nginx/sites-available/kalibrasimedika.co.id.conf \
#            /etc/nginx/sites-enabled/kalibrasimedika.co.id.conf
#   4. certbot --nginx -d kalibrasimedika.co.id -d www.kalibrasimedika.co.id
#      (only if www is actually intended — omit -d www... if not; same
#      Certbot flow already used for the existing sites and for api.*)
#   5. nginx -t   (validate BEFORE reloading)
#   6. systemctl reload nginx   (reload, not restart — does not drop existing
#      connections to bipmed/bumiindah/api.kalibrasimedika.co.id)

server {
    listen 80;
    listen [::]:80;
    server_name kalibrasimedika.co.id;

    # Certbot's HTTP-01 challenge path.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name kalibrasimedika.co.id;

    # Certbot fills these in when run with --nginx (step 4 above).
    ssl_certificate     /etc/letsencrypt/live/kalibrasimedika.co.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kalibrasimedika.co.id/privkey.pem;

    # apps/web-api's own routes are already prefixed "/public/..." (e.g.
    # /public/contact-messages, /public/chat-sessions, /public/whatsapp-lead) —
    # this location strips nothing, it forwards the full /public/... path
    # unchanged so web-api's own Express route matching still sees exactly
    # the same paths it does in dev. NEXT_PUBLIC_WEB_API_URL must therefore
    # be the bare origin (no /public suffix) — see
    # .env.production.example's NEXT_PUBLIC_WEB_API_URL comment.
    location /public/ {
        proxy_pass http://127.0.0.1:3002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
