3. Exact implementation

chat-sessions.service.ts
Lines 244-270
async closeSession(companyId: string, sessionId: string): Promise<ChatSession> {
const session = await prisma.chatSession.findFirst({ where: { id: sessionId, companyId } });
if (!session) {
throw new NotFoundException({ message: "Chat session not found", code: "CHAT_SESSION_NOT_FOUND" });
}
const closedAt = new Date();
return prisma.$transaction(async (tx) => {
const closed = await tx.chatSession.update({
where: { id: sessionId },
data: { status: "CLOSED", closedAt },
});
if (session.contactMessageId) {
await tx.contactMessage.updateMany({
where: {
id: session.contactMessageId,
companyId,
status: { not: "CLOSED" },
},
data: { status: "CLOSED" },
});
}
return closed;
});
}
Relationship: ChatSession.contactMessageId → ContactMessage.id (FK, bukan email/heuristic)
Guard idempotent: status: { not: "CLOSED" }
contactMessageId = null: session tetap ditutup, tidak ada update ContactMessage
Frontend: saat event session_closed, use-chat-socket memanggil notifyContactMessagesChanged() → leads-page-client invalidate contact-messages-statistics dan contact-messages.

