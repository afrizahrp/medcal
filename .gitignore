# Dependencies
node_modules/

# Build / framework output
.next/
dist/
out/
.turbo/
coverage/

# Generated / incremental build artifacts — regenerated on every build,
# only ever produce commit noise (see 0a2c31a "update tsbuildinfo cache")
*.tsbuildinfo
next-env.d.ts

# Local file-store root (FILES_ROOT) — stored file binaries, never committed
.data/

# Environment / secrets
.env
.env.local
.env.*.local
# The real production env file docker-compose.prod.yml's `env_file:` expects
# (contains INTERNAL_API_SECRET, CHAT_SESSION_TOKEN_SECRET, DATABASE_URL,
# etc.) — was not previously ignored, meaning a real .env.production created
# at the repo root would have been eligible for accidental commit. Only
# .env.production.example (the template, no real secrets) should ever be
# tracked.
.env.production

# Logs
*.log

# OS
.DS_Store

# Local git worktree checkouts created by Claude Code agent sessions
# (e.g. isolation: "worktree") — never committed/pushed, local-only.
.claude/worktrees/

# Prisma backup
packages/db/prisma/migrations/**/migration_lock.toml.bak
.env.example
.env.production.example
.env.production.example
