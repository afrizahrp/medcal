}

/// Per-CalibrationJob gate for the customer's AKD/AKL/NIE (Nomor Izin Edar)
/// regulatory declaration. Decided per physical device/item by a
/// TECHNICIAN_MANAGER, never per WorkOrder — a REJECTED job must not block
/// sibling jobs in the same WorkOrder. Orthogonal to CalibrationJobStatus
/// (which tracks execution progress, not this identity gate).
enum AkdAklApprovalStatus {
  /// AKD/AKL/NIE was declared (or is not applicable) — no manager decision needed.
  NOT_REQUIRED
  /// Technician escalated a missing/unacceptable declaration; awaiting TECHNICIAN_MANAGER.
  PENDING_REVIEW
  /// TECHNICIAN_MANAGER cleared this specific device to proceed with calibration.
  APPROVED
  /// TECHNICIAN_MANAGER refused; this job cannot proceed to calibration.
  REJECTED
}

/// Why the AKD/AKL gate is currently open (only meaningful while
/// akdAklApprovalStatus = PENDING_REVIEW). Drives whether an approved identity
/// correction that resolves the declared/observed text mismatch may auto-close
/// the gate: it may for AUTO_MISMATCH, but a MANUAL_ESCALATION was raised by a
/// human for a reason the text comparison cannot see (suspected forgery, etc.)
/// and must wait for an explicit TECHNICIAN_MANAGER decision. Cleared to NULL
/// whenever the gate leaves PENDING_REVIEW for any reason.
enum AkdAklGateOrigin {
  /// Opened automatically because technicianObservedAkdAkl != customerDeclaredAkdAkl.
  AUTO_MISMATCH
  /// Opened by a technician's explicit "Eskalasi AKD/AKL" action.
  MANUAL_ESCALATION
}

/// Manager decision state for an identity correction Berita Acara. Mirrors
/// AkdAklApprovalStatus's shape (minus NOT_REQUIRED — an IdentityCorrection
/// row only exists once a correction is actually submitted). A row enters at
/// PENDING_REVIEW; TECHNICIAN_MANAGER moves it to APPROVED/REJECTED.
enum IdentityCorrectionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

/// Technician request for MT to accept invalid/expired reference equipment on a
/// job. Orthogonal to CalibrationJobStatus and QualityReview — never stamped by
/// submitForReview(). A row enters at PENDING_REVIEW; TECHNICIAN_MANAGER moves
/// it to APPROVED (invalid lines get JobReferenceEquipmentUsed.validityOverridden)
/// or REJECTED. Override is line-level, not a header status.
enum JobReferenceEquipmentApprovalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

/// Snapshot of resolveJobEquipmentValidity at request time (not re-derived later).
enum JobReferenceEquipmentValiditySnapshot {
  VALID
  EXPIRED
  NOT_YET_VALID
  NO_RECORD
  NOT_ACCEPTED_FOR_USE
}

/// Signer roles on an identity correction BA (shared model + discriminator).
enum IdentityCorrectionSignerRole {
  TECHNICIAN
  CUSTOMER
}

/// Signer kinds on Kontrol Alat (F.MU.08) — discriminator values only, NOT
/// Membership roles. Administrasi / Petugas Teknis are existing users.
enum KontrolAlatSignerKind {
  ADMINISTRATION
  TECHNICAL_OFFICER
}

/// Captures "customer unavailable / refused" as a real state, not just a null
/// signature. (Decision 7)
enum SignatureStatus {
  SIGNED
