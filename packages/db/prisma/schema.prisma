// Commercial & Work Order
// =============================================================================

model ServiceTariff {
  id        String   @id @default(cuid())
  companyId String
  code      String
  name      String
  unitPrice Decimal  @db.Decimal(18, 2)
  currency  String   @default("IDR")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items              QuotationItem[]
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([companyId, code])
}

/// Commercial price master — the DEFAULT tariff applied to a QuotationItem when a
/// Quotation is generated from a CalibrationRequest. Keyed by canonical
/// DeviceType (never customerDeviceName / DeviceTypeAlias / Device.id) and
/// company-scoped (same convention as ServiceTariff / Tax).
///
/// Append-only effective dating: a price change is a NEW row with a later
/// `effectiveFrom`, never an in-place edit of an active row. Lookup during
/// quotation generation selects the active row whose [effectiveFrom, effectiveUntil]
/// window contains the quotation date; that price is then SNAPSHOTTED into
/// QuotationItem.unitPrice and the Price List is never consulted again for that
/// quotation. Overlapping active windows for the same (companyId, deviceTypeId)
/// are rejected at the service layer.
model PriceListItem {
  id             String    @id @default(cuid())
  companyId      String
  deviceTypeId   String
  unitPrice      Decimal   @db.Decimal(18, 2)
  currency       String    @default("IDR")
  effectiveFrom  DateTime  @db.Date
  effectiveUntil DateTime? @db.Date
  isActive       Boolean   @default(true)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deviceType DeviceType @relation(fields: [deviceTypeId], references: [id])

  @@unique([companyId, deviceTypeId, effectiveFrom])
  @@index([companyId, deviceTypeId, effectiveFrom])
  @@index([companyId, isActive])
}

model Quotation {
  id                   String          @id @default(cuid())
  companyId            String
  customerId           String
  number               String
  requestId            String          @unique
  source               QuotationSource @default(PORTAL)
  status               QuotationStatus @default(DRAFT)
  validUntil           DateTime?
  subtotal             Decimal         @db.Decimal(18, 2)
  headerDiscountAmount Decimal         @default(0) @db.Decimal(18, 2)
  taxCode              String
  taxRate              Decimal         @db.Decimal(5, 4)
  taxAmount            Decimal         @db.Decimal(18, 2)
  totalAmount          Decimal         @db.Decimal(18, 2)
  currency             String          @default("IDR")
  approvedAt           DateTime?
  approvedByUserId     String?
  customerApprovedAt   DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  request        CalibrationRequest @relation(fields: [requestId], references: [id])
  approvedBy     User?              @relation("QuotationApprovedBy", fields: [approvedByUserId], references: [id])
  items          QuotationItem[]
  purchaseOrders PurchaseOrder[]
  workOrders     WorkOrder[]
  // MOM #1 — Transaction Revision + Immutable History
  history        QuotationHistory[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([customerId])
  @@index([companyId, taxCode])
}

model QuotationItem {
  id             String   @id @default(cuid())
  companyId      String
  quotationId    String
  deviceId       String?
  requestItemId  String?
  tariffId       String?
  description    String
  qty            Decimal  @default(1) @db.Decimal(18, 4)
  unitPrice      Decimal  @db.Decimal(18, 2)
  discountAmount Decimal  @default(0) @db.Decimal(18, 2)
  lineTotal      Decimal  @db.Decimal(18, 2)
  /// True when quotation generation found no applicable PriceListItem for this
  /// line's DeviceType. unitPrice is stored as 0 and the Quotation cannot be
  /// sent/approved until a real price is entered (see QuotationsService.send).
  pricePending   Boolean  @default(false)
  /// MOM #1 — Revision Scope Design. true = active (part of the quotation's
  /// current desired scope); false = retired by a revision that removed this
  /// line after a downstream PurchaseOrderItem had already been generated
  /// from it (see mom-1-final-revision-scope-design-20260920.md §6). A row
  /// with no downstream PurchaseOrderItem is hard-deleted on removal instead.
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  quotation          Quotation               @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  device             Device?                 @relation(fields: [deviceId], references: [id])
  requestItem        CalibrationRequestItem? @relation(fields: [requestItemId], references: [id])
  tariff             ServiceTariff?          @relation(fields: [tariffId], references: [id])
  purchaseOrderItems PurchaseOrderItem[]

  @@index([quotationId])
}

model PurchaseOrder {
  id                   String              @id @default(cuid())
  companyId            String              @db.Char(3)
  customerId           String
  quotationId          String
