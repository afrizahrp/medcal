// medcal MVP Prisma schema
// Sources: docs/ERD (approved 2026-08-02), entity-catalog, ADR-000
// Notes:
// - No branchId (Company only)
// - ContactMessage + GetMessageFrom aligned with server-bi-erp
// - Billable SoR = Certificate.billingStatus
// - MVP billing = Invoice + Payment + CreditNote
// - Better Auth may add/replace auth tables later; User here is domain-facing

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums
// =============================================================================

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum MembershipRole {
  SUPERADMIN
  ADMIN
  SUPERVISOR
  TECHNICIAN
  TECHNICIAN_MANAGER
  FINANCE
  CUSTOMER
  CUSTOMER_SERVICE
}

enum MenuApplication {
  MANAGEMENT
  TECHNICIAN
  CUSTOMER
}

enum EmailWhitelistStatus {
  ACTIVE
  REVOKED
}

enum PushApp {
  WEB
  PORTAL
  TECH_PWA
}

enum GetMessageFrom {
  CONTACTFORM
  WHATSAPP
  CHAT_AI
  CHAT_PERSON
  EMAIL
}

enum ContactStatus {
  PENDING
  READ
  REPLIED
  CLOSED
}

enum MatchStatus {
  NONE
  EXACT_EMAIL
  DOMAIN_CANDIDATE
  CONFIRMED_EXISTING
  DISMISSED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  REJECTED
  CONVERTED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
}

enum ServiceMode {
  ON_SITE
  SEND_TO_LAB
}

enum CalibrationRequestStatus {
  DRAFT
  SUBMITTED
  IN_QUOTATION
  CANCELLED
  FULFILLED
}

/// Status of the customer's AKD/AKL/NIE (Nomor Izin Edar — medical-device
/// distribution permit) declaration for a Requisition line. This captures ONLY
/// what the customer stated at intake — it is never technical verification.
/// The authoritative, technician-verified value is snapshotted later on
/// CalibrationJob (not modelled yet). NULL `akdAkl` is a valid state and must
/// never be treated as NOT_APPLICABLE.
enum AkdAklDeclaration {
  /// Customer has not been asked / has not answered yet (default).
  NOT_PROVIDED
  /// Customer explicitly stated the device has no AKD/AKL/NIE.
  CUSTOMER_DECLARED_NONE
  /// Customer supplied an AKD/AKL/NIE value (stored in `akdAkl`).
  CUSTOMER_PROVIDED
}

enum QuotationSource {
  PORTAL
  PHONE
  WHATSAPP
  OTHER
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  RECEIVED
  CONFIRMED
  FULFILLED
  CANCELLED
}

enum PurchaseOrderItemStatus {
  OPEN
  ALLOCATED
  FULFILLED
  CANCELLED
}

enum WorkOrderStatus {
  PLANNED
  ASSIGNED
  IN_PROGRESS
  /// Legacy value retained for migration safety. WorkOrder API must not use it.
  TECHNICALLY_DONE
  /// Legacy value retained for migration safety. WorkOrder API must not use it.
  CLOSED
  CANCELLED
  /// MVP terminal-complete status. Replaces TECHNICALLY_DONE / CLOSED in the API.
  DONE
}

enum AssignmentRole {
  LEAD
  ASSIST
}

enum CalibrationJobStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  REWORK
  ACCEPTED_BY_QA
}

/// Per-CalibrationJob gate for the customer's AKD/AKL/NIE (Nomor Izin Edar)
/// regulatory declaration. Decided per physical device/item by a
/// TECHNICIAN_MANAGER, never per WorkOrder — a REJECTED job must not block
/// sibling jobs in the same WorkOrder. Orthogonal to CalibrationJobStatus
/// (which tracks execution progress, not this identity gate).
enum AkdAklApprovalStatus {
  /// AKD/AKL/NIE was declared (or is not applicable) — no manager decision needed.
  NOT_REQUIRED
  /// Technician escalated a missing/unacceptable declaration; awaiting TECHNICIAN_MANAGER.
  PENDING_REVIEW
  /// TECHNICIAN_MANAGER cleared this specific device to proceed with calibration.
  APPROVED
  /// TECHNICIAN_MANAGER refused; this job cannot proceed to calibration.
  REJECTED
}

/// Why the AKD/AKL gate is currently open (only meaningful while
/// akdAklApprovalStatus = PENDING_REVIEW). Drives whether an approved identity
/// correction that resolves the declared/observed text mismatch may auto-close
/// the gate: it may for AUTO_MISMATCH, but a MANUAL_ESCALATION was raised by a
/// human for a reason the text comparison cannot see (suspected forgery, etc.)
/// and must wait for an explicit TECHNICIAN_MANAGER decision. Cleared to NULL
/// whenever the gate leaves PENDING_REVIEW for any reason.
enum AkdAklGateOrigin {
  /// Opened automatically because technicianObservedAkdAkl != customerDeclaredAkdAkl.
  AUTO_MISMATCH
  /// Opened by a technician's explicit "Eskalasi AKD/AKL" action.
  MANUAL_ESCALATION
}

/// Manager decision state for an identity correction Berita Acara. Mirrors
/// AkdAklApprovalStatus's shape (minus NOT_REQUIRED — an IdentityCorrection
/// row only exists once a correction is actually submitted). A row enters at
/// PENDING_REVIEW; TECHNICIAN_MANAGER moves it to APPROVED/REJECTED.
enum IdentityCorrectionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

/// Signer roles on an identity correction BA (shared model + discriminator).
enum IdentityCorrectionSignerRole {
  TECHNICIAN
  CUSTOMER
}

/// Captures "customer unavailable / refused" as a real state, not just a null
/// signature. (Decision 7)
enum SignatureStatus {
  SIGNED
  UNAVAILABLE
  REFUSED
}

enum ReviewDecision {
  APPROVE
  REJECT
}

enum QualityReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CertificateStatus {
  DRAFT
  ISSUED
  REVOKED
  SUPERSEDED
}

enum CertificateBillingStatus {
  UNBILLED
  BILLABLE
  INVOICED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  TRANSFER
  CASH
  OTHER
}

enum CreditNoteStatus {
  DRAFT
  ISSUED
  APPLIED
  VOID
}

enum DocumentType {
  CUSTOMER
  CALIBRATION_REQUEST
  QUOTATION
  PURCHASE_ORDER
  WORK_ORDER
  WORK_ORDER_SEND_TO_LAB
  EQUIPMENT_DELIVERY_NOTE
  INVOICE
  CERTIFICATE
  CREDIT_NOTE
  /// Berita Acara Identitas — identity correction (device_id / serial / AKD-AKL).
  /// Prefix "BAI". Number allocated from IdentityCorrection.number. (Decision 9)
  IDENTITY_CORRECTION_BA
}

enum ReminderChannel {
  EMAIL
  PUSH
  WHATSAPP
}

enum ReminderEventStatus {
  SCHEDULED
  SENT
  FAILED
  CANCELLED
}

// Real-time Web Chat conversation domain (separate from the Lead-intake
// domain below) — locked 2026-08-16 Web Chat correction audit + technical
// spike. A ChatSession's OPEN/CLOSED lifecycle is deliberately the only two
// states for MVP (no IDLE/EXPIRED/AUTO_CLOSED/ARCHIVED — no auto-close
// requirement exists yet).
enum ChatSessionStatus {
  OPEN
  CLOSED
}

// VISITOR = the anonymous visitor side of a ChatSession; ADMIN = a staff
// reply. No AI sender type — human-only chat is a locked product decision.
enum ChatSenderType {
  VISITOR
  ADMIN
}

enum FileOwnerType {
  CERTIFICATE
  JOB_EVIDENCE
  SIGNATURE
  REQUEST_ATTACHMENT
  INVOICE
  CREDIT_NOTE
  // Reference-equipment calibration certificate/evidence. ownerId =
  // EquipmentCalibrationRecord.id (that model is Phase 2B — not built yet).
  EQUIPMENT_CALIBRATION
  /// Signature image on an IdentityCorrectionSignature row. ownerId =
  /// IdentityCorrectionSignature.id. Deliberately NOT reusing SIGNATURE
  /// (which is CustomerSignature-on-job). (Decision 10)
  IDENTITY_CORRECTION
  OTHER
}

enum UomCategory {
  PRESSURE
  TEMPERATURE
  RATE
  FLOW
  PERCENTAGE
  LENGTH
  MASS
  VOLUME
  TIME
  ELECTRICAL
  OTHER
}

enum CalibrationValueType {
  NUMBER
  RATIO
  TEXT
  BOOLEAN
}

// Email → Lead Management (locked plan)
enum EmailFolder {
  INBOX
  SENT
  DRAFTS
  TRASH
}

enum EmailStatus {
  UNREAD
  READ
}

// =============================================================================
// Organization & IAM
// =============================================================================

model Company {
  id           String        @id @db.Char(3)
  name         String        @db.VarChar(50)
  legalName    String?       @db.VarChar(50)
  taxId        String?       @db.VarChar(25)
  address      String?       @db.VarChar(100)
  phone        String?       @db.VarChar(25)
  email        String?       @db.VarChar(50)
  status       CompanyStatus @default(ACTIVE)
  settingsJson Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  memberships                 UserMembership[]
  contactMessages             ContactMessage[]
  chatSessions                ChatSession[]
  leads                       Lead[]
  customers                   Customer[]
  devices                     Device[]
  equipment                   Equipment[]
  equipmentCalibrationRecords EquipmentCalibrationRecord[]
  calibrationRequests         CalibrationRequest[]
  serviceTariffs              ServiceTariff[]
  priceListItems              PriceListItem[]
  taxes                       Tax[]
  quotations                  Quotation[]
  purchaseOrders              PurchaseOrder[]
  workOrders                  WorkOrder[]
  certificates                Certificate[]
  invoices                    Invoice[]
  creditNotes                 CreditNote[]
  reminderEvents              ReminderEvent[]
  fileObjects                 FileObject[]
  fcmTokens                   FCMToken[]
  emails                      Email[]
  documentNumberSequences     DocumentNumberSequence[]
  workOrderEquipment          WorkOrderEquipment[]
  equipmentDeliveryNotes      EquipmentDeliveryNote[]
}

model DocumentNumberSequence {
  id           String       @id @default(cuid())
  companyId    String       @db.Char(3)
  documentType DocumentType
  prefix       String       @db.Char(3)
  year         Int
  lastSequence Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, documentType, year])
  @@index([companyId, documentType])
}

// Monotonic counters for auto-generated master business codes (Device
// Management Master Identity & Coding Standard). One row per scope:
// `"<ENTITY>#<companyId>"` for company-scoped entities (Device, Equipment),
// `"<ENTITY>"` for global ones. Allocated atomically by MasterCodeService via
// INSERT ... ON CONFLICT DO UPDATE ... RETURNING — never MAX(code)+1. Numbers
// are never reused; gaps (from rollback) are acceptable.
model MasterCodeSequence {
  id           String   @id @default(cuid())
  scope        String   @unique
  lastSequence Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique @db.VarChar(50)
  name          String?    @db.VarChar(50)
  status        UserStatus @default(INVITED)
  // Better Auth-owned bookkeeping fields (locked: no email verification step enforced,
  // but the column is part of Better Auth's own user-model contract).
  emailVerified Boolean    @default(false)
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  memberships                           UserMembership[]
  customerLinks                         CustomerUserLink[]
  fcmTokens                             FCMToken[]
  assignedLeads                         Lead[]                       @relation("LeadAssignee")
  confirmedMatches                      ContactMessage[]             @relation("MatchConfirmer")
  workOrderAssignments                  WorkOrderAssignment[]
  qualityReviews                        QualityReview[]              @relation("Reviewer")
  sessions                              Session[]
  accounts                              Account[]
  emailWhitelistCreated                 EmailWhitelist[]             @relation("EmailWhitelistCreator")
  emailWhitelistRevoked                 EmailWhitelist[]             @relation("EmailWhitelistRevoker")
  menusCreated                          Menu[]                       @relation("MenuCreatedBy")
  menusUpdated                          Menu[]                       @relation("MenuUpdatedBy")
  sentEmails                            Email[]                      @relation("EmailSender")
  rolePermissionsCreated                RolePermission[]             @relation("RolePermissionCreatedBy")
  rolePermissionsUpdated                RolePermission[]             @relation("RolePermissionUpdatedBy")
  uploadedFiles                         FileObject[]                 @relation("FileUploadedBy")
  equipmentCalibrationsCreated          EquipmentCalibrationRecord[] @relation("EquipmentCalibrationCreatedBy")
  equipmentCalibrationsAccepted         EquipmentCalibrationRecord[] @relation("EquipmentCalibrationAcceptedBy")
  calibrationJobsAkdAklApproved         CalibrationJob[]             @relation("CalibrationJobAkdAklApprover")
  identityCorrectionsSubmitted          IdentityCorrection[]         @relation("IdentityCorrectionSubmitter")
  identityCorrectionsDecided            IdentityCorrection[]         @relation("IdentityCorrectionDecider")
  jobReferenceEquipmentUsagesOverridden JobReferenceEquipmentUsed[]  @relation("JobReferenceEquipmentOverrider")
}

// =============================================================================
// Better Auth — owned tables (locked: hosted in-process inside apps/api;
// domain-facing User model above is reused as Better Auth's user model)
// =============================================================================

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

model UserMembership {
  id                   String         @id @default(cuid())
  userId               String
  companyId            String
  role                 MembershipRole
  isDefault            Boolean        @default(false)
  // Company-scoped push notification eligibility — NOT a permission/role grant.
  // When false, dispatch must not send FCM to this user for this company.
  receiveNotifications Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

// Menu Registry (locked 2026-08-19: DB-backed menu definitions, permission-
// derived visibility). Menu is navigation/config only — NOT a second
// authorization source. A leaf's viewResource/viewAction is looked up via the
// existing hasPermission(role, resource, action) catalog at read time; this
// model never stores role/permission grants itself. No companyId/branchId:
// company is deployment-scoped via COMPANY_ID, branch does not exist in this
// schema (see file header). Sibling `order` uniqueness within
// (application, parentId) is validated in the service layer, not here —
// Postgres treats NULL parentId values as distinct, which would defeat a
// root-level DB uniqueness constraint.
model Menu {
  id              String          @id @default(cuid())
  application     MenuApplication
  code            String
  parentId        String?
  label           String
  href            String?
  icon            String?
  order           Int             @default(0)
  isGroup         Boolean         @default(false)
  isActive        Boolean         @default(true)
  viewResource    String?
  viewAction      String?
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  parent    Menu?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children  Menu[] @relation("MenuHierarchy")
  createdBy User?  @relation("MenuCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy User?  @relation("MenuUpdatedBy", fields: [updatedByUserId], references: [id])

  @@unique([application, code])
  @@index([application, parentId])
}

// DB-driven Role -> Permission grants (locked 2026-08-20). Role/permission
// assignment is now data, not code: hasPermission(role, resource, action)
// reads from this table (via an in-memory cache) instead of a hardcoded
// per-role statement map. The set of valid (resource, action) pairs itself
// stays code-defined in packages/auth/src/access-control.ts's permission
// catalog — a pair is only meaningful once some route actually enforces it,
// so this table stores which roles hold which of those pairs, not the pairs
// themselves. SUPERADMIN intentionally has NO rows here: hasPermission
// hardcodes an unconditional bypass for SUPERADMIN so it can never be locked
// out via this table (including by mistake through the admin UI). No
// isActive flag — a missing row simply means "not granted". No
// companyId/branchId/applicationId, matching Menu's precedent: this
// deployment is company-scoped via COMPANY_ID, not per-row.
model RolePermission {
  id              String         @id @default(cuid())
  role            MembershipRole
  resource        String
  action          String
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  createdBy User? @relation("RolePermissionCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy User? @relation("RolePermissionUpdatedBy", fields: [updatedByUserId], references: [id])

  @@unique([role, resource, action])
  @@index([role])
}

// Registration gate (F4, locked): reusable, not consumed — a revoked row still
// exists but no longer authorizes sign-up. Standalone, no companyId.
// createdBy is nullable ONLY for the one-time SUPERADMIN bootstrap entry (see
// apps/api/src/bootstrap-superadmin.ts): NULL means "created by the bootstrap
// process, not by a user" — there is no admin yet at that point. Every entry
// created through the normal whitelist:manage flow (WhitelistService.create)
// always supplies a real createdBy and must continue to do so.
model EmailWhitelist {
  id        String               @id @default(cuid())
  email     String               @unique
  status    EmailWhitelistStatus @default(ACTIVE)
  createdBy String?
  createdAt DateTime             @default(now())
  revokedBy String?
  revokedAt DateTime?

  creator User? @relation("EmailWhitelistCreator", fields: [createdBy], references: [id])
  revoker User? @relation("EmailWhitelistRevoker", fields: [revokedBy], references: [id])

  @@index([status])
}

model CustomerUserLink {
  id         String   @id @default(cuid())
  userId     String
  customerId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([userId, customerId])
  @@index([customerId])
}

model FCMToken {
  id         String    @id @default(cuid())
  companyId  String
  userId     String
  token      String    @unique
  deviceType String
  app        PushApp
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId])
}

// =============================================================================
// Acquisition — ContactMessage (bi-erp) + Lead
// =============================================================================

model ContactMessage {
  id                String         @id @default(cuid())
  companyId         String
  getFrom           GetMessageFrom @default(CONTACTFORM)
  status            ContactStatus  @default(PENDING)
  subject           String?
  topicId           Int?
  message           String
  name              String
  email             String
  phone             String?
  // Canonical digit-only form of `phone` (see normalizePhone in @medcal/shared),
  // computed at write time — used for Lead identity matching (see Lead below),
  // kept separate from `phone` so the original submitted value is preserved.
  phoneNormalized   String?
  organizationName  String?
  utmJson           Json?
  matchStatus       MatchStatus    @default(NONE)
  matchedCustomerId String?
  confirmedByUserId String?
  confirmedAt       DateTime?
  leadId            String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  matchedCustomer Customer?     @relation("ContactMatchCandidate", fields: [matchedCustomerId], references: [id])
  lead            Lead?         @relation(fields: [leadId], references: [id])
  confirmedBy     User?         @relation("MatchConfirmer", fields: [confirmedByUserId], references: [id])
  topic           ContactTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  // Set when this ContactMessage is the one first-touch lead-intake record
  // created by a Web Chat ChatSession (see ChatSession.contactMessageId) —
  // null for every other channel (CONTACTFORM, WHATSAPP, EMAIL, etc.).
  chatSession     ChatSession?
  emails          Email[]

  @@index([companyId, createdAt])
  @@index([companyId, email])
  @@index([companyId, status])
  @@index([companyId, getFrom])
  @@index([leadId])
}

// Static, seeded lookup for Contact Form topic selection — global (no companyId),
// no admin CRUD by design (matches the reference implementation's own proportions).
model ContactTopic {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ContactMessage[]

  @@index([isActive])
}

// Unit of Measurement master data — global (no companyId) since UOMs are
// universal scientific standards (mmHg, °C, kPa, etc.) that don't vary by
// company. Admin CRUD enabled for extensibility, unlike ContactTopic.
model Uom {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  symbol    String
  category  UomCategory
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  calibrationParameters DeviceCalibrationParameter[]

  @@index([category])
  @@index([isActive])
}

// Aggregate root over multiple channel interactions (Lead Inbox design review,
// 2026-08-16, Decision 1): one Lead may have many ContactMessage rows across
// different getFrom channels. name/email/phone/organizationName are a
// denormalized snapshot (Decision 2) populated from the first ContactMessage
// at Lead-creation time, used as the inbox list's display source of truth —
// ContactMessage rows remain the historical record of what was actually
// submitted on each interaction.
model Lead {
  id               String     @id @default(cuid())
  companyId        String
  status           LeadStatus @default(NEW)
  name             String
  email            String
  phone            String?
  organizationName String?
  assignedToUserId String?
  customerId       String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactMessages     ContactMessage[]
  assignedTo          User?                @relation("LeadAssignee", fields: [assignedToUserId], references: [id])
  customer            Customer?            @relation(fields: [customerId], references: [id])
  calibrationRequests CalibrationRequest[]
  suggestedInEmails   Email[]              @relation("EmailSuggestion")
  emails              Email[]              @relation("EmailAssociation")

  @@index([companyId, status])
  @@index([companyId, createdAt])
}

// Real-time Web Chat conversation domain (locked 2026-08-16, Web Chat
// correction audit + technical spike). Deliberately separate from the Lead
// domain above: a ChatSession creates AT MOST ONE ContactMessage (the
// first-touch lead-intake record, getFrom=CHAT_PERSON), never one per
// message — the full transcript lives in ChatMessage. contactMessageId is
// nullable (set once, right after the linked ContactMessage is created —
// see Phase 1's ChatSessionsService for the exact sequencing) and @unique
// so the database itself enforces "at most one ChatSession per
// ContactMessage" and, by the service never calling create twice per
// session, "at most one ContactMessage per ChatSession".
//
// No assignedToUserId — MVP is a shared inbox (no per-session ownership),
// matching Lead's own deferred assignment decision. No auto-close/expiry
// state — OPEN/CLOSED only.
model ChatSession {
  id                String            @id @default(cuid())
  companyId         String
  visitorName       String
  visitorEmail      String
  status            ChatSessionStatus @default(OPEN)
  contactMessageId  String?           @unique
  closedAt          DateTime?
  // Unread tracking (Management header notification audit, 2026-08-17):
  // null = admin has never read this session, or a VISITOR message has
  // arrived since the last time they did. Set only via the explicit
  // PATCH /chat-sessions/:id/read action (ChatSessionsService.markRead) —
  // mirrors ContactMessage's PENDING->READ convention (see
  // contact-messages-query.controller.ts) rather than inventing a new
  // unread mechanism. A session is "unread" when its latest VISITOR
  // ChatMessage.createdAt is newer than this timestamp (see
  // ChatSessionsService.countUnread) — deliberately NOT the same thing as
  // status=OPEN, which only tracks whether the conversation has ended.
  lastReadByAdminAt DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactMessage ContactMessage? @relation(fields: [contactMessageId], references: [id])
  messages       ChatMessage[]

  @@index([companyId, status])
  @@index([companyId, createdAt])
}

// One row per conversation turn (visitor or admin). `seq` is a
// table-wide monotonic counter (not reset per session) — sufficient for
// deterministic per-session ordering since every read is already scoped to
// one sessionId; a per-session counter would need its own transaction/lock
// machinery for no additional ordering guarantee this schema needs.
// `clientMessageId` + the compound unique index below is the
// duplicate-submission guard: a resend of the same client-generated id
// within the same session is rejected at the database level, not just
// application logic.
model ChatMessage {
  id              String         @id @default(cuid())
  companyId       String
  sessionId       String
  seq             Int            @default(autoincrement())
  senderType      ChatSenderType
  senderUserId    String?
  body            String
  clientMessageId String?
  createdAt       DateTime       @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, clientMessageId])
  @@index([sessionId, seq])
}

// Email → Lead Management (locked plan): single Email model for all folders.
// STRICT AUTO-SUGGEST ONLY: leadId is NEVER automatically set — always null
// until staff action. suggestedLeadId holds the system suggestion.
model Email {
  id        String @id @default(cuid())
  companyId String

  // IMAP deduplication — RFC Message-ID header
  messageId String? @unique

  // Sender/Recipients
  fromEmail String
  fromName  String?
  toEmail   String
  toName    String?
  ccEmail   String?
  bccEmail  String?

  // Content
  subject  String
  body     String  @db.Text
  textBody String? @db.Text

  // Mailbox state
  folder    EmailFolder @default(INBOX)
  status    EmailStatus @default(UNREAD)
  isStarred Boolean     @default(false)

  // Internal reply chain (MedCal cuid, NOT RFC header)
  parentEmailId String?

  // RFC metadata (for protocol behavior, NOT for internal threading)
  rfcInReplyTo  String? @db.Text
  rfcReferences String? @db.Text

  // Lead association - STRICT AUTO-SUGGEST
  suggestedLeadId String? // System suggestion only
  leadId          String? // Staff-confirmed only

  // ContactMessage link
  contactMessageId String?

  // Sender user (outbound)
  sentByUserId String?

  // Timestamps
  sentAt     DateTime?
  receivedAt DateTime?
  readAt     DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relations
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  suggestedLead  Lead?           @relation("EmailSuggestion", fields: [suggestedLeadId], references: [id], onDelete: SetNull)
  lead           Lead?           @relation("EmailAssociation", fields: [leadId], references: [id], onDelete: SetNull)
  contactMessage ContactMessage? @relation(fields: [contactMessageId], references: [id], onDelete: SetNull)
  sentBy         User?           @relation("EmailSender", fields: [sentByUserId], references: [id])
  parentEmail    Email?          @relation("EmailThread", fields: [parentEmailId], references: [id], onDelete: SetNull)
  replies        Email[]         @relation("EmailThread")

  @@index([companyId, folder])
  @@index([companyId, status])
  @@index([companyId, leadId])
  @@index([companyId, suggestedLeadId])
  @@index([companyId, createdAt])
  @@index([messageId])
  @@index([contactMessageId])
  @@index([parentEmailId])
}

model Customer {
  id        String         @id @default(cuid())
  companyId String
  number    String
  name      String
  legalName String?
  taxId     String?
  address   String?
  phone     String?
  mobile    String?
  email     String?
  status    CustomerStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts            CustomerContact[]
  userLinks           CustomerUserLink[]
  devices             Device[]
  leads               Lead[]
  matchedMessages     ContactMessage[]     @relation("ContactMatchCandidate")
  calibrationRequests CalibrationRequest[]
  quotations          Quotation[]
  purchaseOrders      PurchaseOrder[]
  workOrders          WorkOrder[]
  certificates        Certificate[]
  invoices            Invoice[]
  creditNotes         CreditNote[]
  reminderEvents      ReminderEvent[]
  fileObjects         FileObject[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, name])
}

model CustomerContact {
  id         String   @id @default(cuid())
  companyId  String
  customerId String
  name       String
  email      String?
  phone      String?
  title      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([companyId, email])
}

// =============================================================================
// Devices & Request
// =============================================================================

// Device taxonomy master data — global (no companyId), same convention as Uom.
// DeviceCategory is an internal domain grouping; DeviceType.name is the
// confirmed Kemenkes capability list (35 types). Device.deviceTypeId is the
// required FK to DeviceType; Device.category remains a free-text snapshot.
model DeviceCategory {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  types DeviceType[]

  @@index([isActive])
}

model DeviceType {
  id          String   @id @default(cuid())
  categoryId  String
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category                DeviceCategory                   @relation(fields: [categoryId], references: [id])
  models                  DeviceModel[]
  devices                 Device[]
  calibrationParameters   DeviceCalibrationParameter[]
  capabilityOrders        DeviceTypeCapabilityOrder[]
  calibrationRequestItems CalibrationRequestItem[]
  equipmentRequirements   DeviceTypeEquipmentRequirement[]
  aliases                 DeviceTypeAlias[]
  priceListItems          PriceListItem[]

  @@index([categoryId])
  @@index([isActive])
}

// Customer-terminology synonyms for a DeviceType — global master (no companyId,
// mirroring DeviceType). Purpose: deterministic mapping of customer wording
// ("Tensimeter", "Blood Pressure Monitor") to the official MEDCAL DeviceType
// ("Sphygmomanometer") during Excel import matching. `alias` keeps the original
// text for display; `normalizedAlias` is the lowercased / trimmed /
// whitespace-collapsed matching key. The @@unique on normalizedAlias guarantees
// one alias resolves to AT MOST one DeviceType — ambiguity is impossible by
// construction, never resolved arbitrarily.
model DeviceTypeAlias {
  id              String   @id @default(cuid())
  deviceTypeId    String
  alias           String
  normalizedAlias String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deviceType DeviceType @relation(fields: [deviceTypeId], references: [id], onDelete: Cascade)

  @@unique([normalizedAlias])
  @@index([deviceTypeId])
  @@index([isActive])
}

// Calibration equipment / tools master — global (no companyId), same convention
// as Uom / DeviceCapability / DeviceCategory. This is the TYPE/CATEGORY of
// reference equipment (e.g. "Electrical Safety Analyzer"), NOT a physical
// instance — it deliberately has no serialNumber / assetTag / calibrationDueDate
// / status-of-a-unit / location / ownership fields. Those belong to the future
// physical Equipment instance layer (Phase 2 — see
// docs/claude/plans/device-management/equipment/implementation_report_equipment_audit.md).
// `category` is a free-text grouping hint (open business question in the audit —
// kept a nullable string rather than an enum until a controlled vocabulary is
// confirmed).
model EquipmentType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deviceRequirements DeviceTypeEquipmentRequirement[]
  equipment          Equipment[]

  @@index([isActive])
}

// Physical reference equipment — an INDIVIDUAL PKM-owned unit of an
// EquipmentType (e.g. "ESA-001", a Fluke ESA620 SN 12345). Company-scoped
// (companyId required), same convention as Device. `code` is the internal asset
// identity, unique per company. serialNumber is nullable and NOT unique (matches
// Device.serialNumber). Phase 2A is the master only: it deliberately carries NO
// calibration-validity / calibration-record / certificate / ownership / location
// / maintenance / inventory fields — current validity will be DERIVED from a
// future EquipmentCalibrationRecord[] (Phase 2B). See
// docs/claude/plans/device-management/equipment/implementation_report_equipment_phase2a_audit.md.
model Equipment {
  id              String   @id @default(cuid())
  companyId       String
  equipmentTypeId String
  code            String
  brand           String?
  model           String?
  serialNumber    String?
  isActive        Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  equipmentType EquipmentType @relation(fields: [equipmentTypeId], references: [id])

  calibrationRecords  EquipmentCalibrationRecord[]
  workOrderSelections WorkOrderEquipment[]
  jobReferenceUsages  JobReferenceEquipmentUsed[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@index([companyId, serialNumber])
  @@index([equipmentTypeId])
}

// Phase 2B lifecycle status. DRAFT = evidence being entered, freely editable /
// deletable. CONFIRMED = historical evidence, locked against normal editing and
// deletion; attached FileObjects become immutable via the EQUIPMENT_CALIBRATION
// FileOwnerPolicy. Corrections after CONFIRMED = a new record, never an edit.
enum EquipmentCalibrationRecordStatus {
  DRAFT
  CONFIRMED
}

// One historical calibration event of a physical Equipment unit. Append-only:
// current calibration validity is DERIVED from these records for a reference
// date (validityservice) — there is deliberately NO Equipment.calibrationDueDate
// / Equipment.calibrationStatus source-of-truth field. `result` is the lab's
// outcome (free text — controlled vocabulary is an OPEN business decision, see
// implementation_report_equipment_phase2b.md); `acceptedForUse` is MEDCAL's
// separate acceptance decision and is NOT auto-derived from `result`. Supporting
// certificate PDFs attach through the generic FilesModule
// (FileObject.ownerType = EQUIPMENT_CALIBRATION, ownerId = this record's id) —
// no typed relation because FileObject.ownerId is polymorphic.
model EquipmentCalibrationRecord {
  id                String                           @id @default(cuid())
  companyId         String
  equipmentId       String
  calibrationDate   DateTime                         @db.Date
  validFrom         DateTime?                        @db.Date
  validUntil        DateTime                         @db.Date
  certificateNumber String?
  provider          String?
  result            String?
  remarks           String?
  acceptedForUse    Boolean                          @default(false)
  acceptedByUserId  String?
  acceptedAt        DateTime?
  acceptanceNotes   String?
  status            EquipmentCalibrationRecordStatus @default(DRAFT)
  createdByUserId   String?
  createdAt         DateTime                         @default(now())
  updatedAt         DateTime                         @updatedAt

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  equipment  Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  acceptedBy User?     @relation("EquipmentCalibrationAcceptedBy", fields: [acceptedByUserId], references: [id])
  createdBy  User?     @relation("EquipmentCalibrationCreatedBy", fields: [createdByUserId], references: [id])

  jobReferenceUsages JobReferenceEquipmentUsed[]

  @@index([equipmentId, calibrationDate])
  @@index([equipmentId, validUntil])
  @@index([companyId, status])
}

// "Required Equipment" — declares that calibrating a given DeviceType normally
// requires a given EquipmentType. Master configuration only: it is NOT an
// assignment, NOT a per-job snapshot, and carries no quantity / mandatory-flag /
// priority / lifecycle (all deferred — see the audit's open questions). The
// required set for a CalibrationJob is derived at read time from
// job.device.deviceTypeId, never copied onto WorkOrder / CalibrationJob.
model DeviceTypeEquipmentRequirement {
  id              String   @id @default(cuid())
  deviceTypeId    String
  equipmentTypeId String
  notes           String?
  // Operational order of this equipment within its parent DeviceType on the
  // Equipment Requirements screen and the future generated calibration
  // worksheet ("A. Daftar Alat yang Digunakan"). The order is business data,
  // not presentation — it belongs on this DeviceType x EquipmentType
  // relationship, never on the reusable EquipmentType master. Written in a
  // single transactional pass (multiples of 10); reads tie-break on equipment
  // type name for determinism. Existing rows are seeded per-DeviceType from
  // row-creation order by the add_equipment_requirement_sort_order migration.
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deviceType    DeviceType    @relation(fields: [deviceTypeId], references: [id])
  equipmentType EquipmentType @relation(fields: [equipmentTypeId], references: [id])

  @@unique([deviceTypeId, equipmentTypeId])
  @@index([deviceTypeId])
  @@index([equipmentTypeId])
}

// Product/model master under a DeviceType — manufacturer is a plain string
// this phase (not a DeviceManufacturer entity). Unique per
// (deviceTypeId, manufacturer, model); the same model name may exist under
// a different DeviceType. Do not FK Device to this model yet.
model DeviceModel {
  id           String   @id @default(cuid())
  deviceTypeId String
  manufacturer String
  model        String
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  deviceType DeviceType @relation(fields: [deviceTypeId], references: [id])

  @@unique([deviceTypeId, manufacturer, model])
  @@index([deviceTypeId])
  @@index([isActive])
}

// Device function/capability master — global (no companyId), same convention
// as Uom/DeviceCategory. DeviceCapabilityItem is a child of a capability
// (e.g. NIBP → Systolic/Diastolic/MAP). DeviceCalibrationParameter is a
// master definition of what is measured/assessed during calibration, unique
// per (deviceTypeId, capabilityItemId, code). Do not FK DeviceModel or Device
// to these models this phase.
model DeviceCapability {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items            DeviceCapabilityItem[]
  deviceTypeOrders DeviceTypeCapabilityOrder[]

  @@index([isActive])
}

// Internal taxonomy leaf: groups DeviceCalibrationParameters under a
// DeviceCapability (e.g. NIBP -> Systolic / Diastolic / MAP). No business
// identity — identified by `id` and `name` only; deliberately has no `code`.
model DeviceCapabilityItem {
  id           String   @id @default(cuid())
  capabilityId String
  name         String
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  capability            DeviceCapability             @relation(fields: [capabilityId], references: [id])
  calibrationParameters DeviceCalibrationParameter[]

  @@unique([capabilityId, name])
  @@index([capabilityId])
  @@index([isActive])
}

// Master definition of a calibration measurement parameter for a DeviceType,
// under a DeviceCapabilityItem. valueType declares the kind of value the
// parameter expects; uom is required in meaning for NUMBER, optional for
// RATIO/TEXT/BOOLEAN. toleranceMin/toleranceMax store the comparable
// acceptance bounds (nullable for upper-bound-only or unresolved cases);
// toleranceNote keeps the verbatim LK wording. Unique per
// (deviceTypeId, capabilityItemId, code).
model DeviceCalibrationParameter {
  id               String               @id @default(cuid())
  deviceTypeId     String
  capabilityItemId String
  code             String
  name             String
  description      String?
  valueType        CalibrationValueType @default(NUMBER)
  uomId            String?
  toleranceMin     Decimal?             @db.Decimal(18, 4)
  toleranceMax     Decimal?             @db.Decimal(18, 4)
  toleranceNote    String?
  // Digits after the decimal point required for this parameter's measured
  // calibration result. Only meaningful for valueType = NUMBER; NULL for
  // RATIO/TEXT/BOOLEAN. Existing NUMBER rows were backfilled with a uniform
  // safe default of 0 (accurate per-parameter values are a separate follow-up).
  // A CHECK constraint bounds it to 0..10 (see migrations).
  decimalPlaces    Int?
  // Display order of this parameter within its (deviceTypeId, capability) scope
  // on the calibration-parameter screen and the future generated worksheet.
  // Written in a single transactional pass (multiples of 10); reads tie-break
  // on `name`. Existing rows are seeded by backfill-calibration-ordering.ts.
  sortOrder        Int                  @default(0)
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  deviceType     DeviceType           @relation(fields: [deviceTypeId], references: [id])
  capabilityItem DeviceCapabilityItem @relation(fields: [capabilityItemId], references: [id])
  uom            Uom?                 @relation(fields: [uomId], references: [id])

  @@unique([deviceTypeId, capabilityItemId, code])
  @@index([deviceTypeId])
  @@index([capabilityItemId])
  @@index([uomId])
  @@index([isActive])
}

// Per-DeviceType ordering of DeviceCapabilities on the calibration-parameter
// screen and (future) generated worksheet. A DeviceCapability is a shared
// global master reused across many DeviceTypes, so its display order cannot
// live on the master — it belongs on this DeviceType x Capability relationship.
// `sortOrder` is an integer written in a single transactional pass (multiples
// of 10); reads tie-break on capability name for determinism.
model DeviceTypeCapabilityOrder {
  id           String   @id @default(cuid())
  deviceTypeId String
  capabilityId String
  sortOrder    Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  deviceType DeviceType       @relation(fields: [deviceTypeId], references: [id], onDelete: Cascade)
  capability DeviceCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([deviceTypeId, capabilityId])
  @@index([deviceTypeId])
}

model Device {
  id           String       @id @default(cuid())
  companyId    String
  // Auto-generated, immutable business code (DVC-000001), unique per company.
  // Issued by MasterCodeService on create; never user-supplied or editable.
  code         String
  customerId   String
  deviceTypeId String
  brand        String?
  model        String?
  serialNumber String?
  category     String?
  locationText String?
  status       DeviceStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deviceType DeviceType @relation(fields: [deviceTypeId], references: [id])

  quotationItems          QuotationItem[]
  purchaseOrderItems      PurchaseOrderItem[]
  calibrationJobs         CalibrationJob[]
  certificates            Certificate[]
  identityCorrectionsPrev IdentityCorrection[] @relation("IdentityCorrectionPrevDevice")
  identityCorrectionsNew  IdentityCorrection[] @relation("IdentityCorrectionNewDevice")

  @@unique([companyId, code])
  @@index([companyId, customerId])
  @@index([companyId, serialNumber])
  @@index([deviceTypeId])
}

model CalibrationRequest {
  id          String      @id @default(cuid())
  companyId   String
  customerId  String
  number      String
  leadId      String?
  serviceMode ServiceMode

  /// The date expected/requested by the customer for calibration service.
  /// This is the canonical scheduling field for CalibrationRequest.
  expectedDate DateTime? @db.Date

  /// @deprecated Use `expectedDate` instead.
  /// This field is retained for backward compatibility with existing data.
  /// Do not use in new code. Will be removed in a future cleanup revision.
  desiredScheduleNote String?

  status    CalibrationRequestStatus @default(DRAFT)
  notes     String?
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead     Lead?    @relation(fields: [leadId], references: [id])

  items     CalibrationRequestItem[]
  quotation Quotation?

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([customerId])
}

model CalibrationRequestItem {
  id                 String            @id @default(cuid())
  companyId          String
  requestId          String
  deviceTypeId       String
  /// Customer's original terminology / name for the equipment, preserved verbatim
  /// (e.g. "Tensimeter Digital" while the mapped DeviceType is "Sphygmomanometer").
  /// Nullable: not always captured for manual / legacy rows.
  customerDeviceName String?
  /// Customer-provided equipment model designation, if available (free-text).
  /// Not a relation to any Model master.
  model              String?
  /// Customer-provided physical device identifier (free-text). Not a FK to Device,
  /// and intentionally NULLABLE — a missing customer Device ID is a valid business
  /// state. Never store a fake placeholder ("000" / "-" / "N/A"). This is NOT the
  /// future CalibrationJob Device.id (that physical identity is assigned later,
  /// on site, by the technician).
  deviceId           String?
  /// Aggregate quantity for this line — how many physical units of this
  /// device the customer is requesting. Excel import keeps one row per
  /// spreadsheet line and stores its Qty here (it is NOT split into N rows).
  /// Manual "+ Requisition" entry creates one row per device, so qty stays 1.
  /// A CHECK constraint enforces qty >= 1 (see migration).
  qty                Int               @default(1)
  /// Customer-declared AKD/AKL/NIE (Nomor Izin Edar) for this device, verbatim
  /// and free-text. Intentionally NULLABLE — the customer often does not know it
  /// at Requisition stage. This is a declaration only, NOT technical
  /// verification; the authoritative value is captured later on CalibrationJob.
  /// Never store a placeholder ("-" / "N/A"); use `akdAklDeclaration` to record
  /// "customer says there is none".
  akdAkl             String?
  /// Provenance of `akdAkl` — see the AkdAklDeclaration enum.
  akdAklDeclaration  AkdAklDeclaration @default(NOT_PROVIDED)
  notes              String?
  createdAt          DateTime          @default(now())

  request         CalibrationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  deviceType      DeviceType         @relation(fields: [deviceTypeId], references: [id])
  quotationItems  QuotationItem[]
  calibrationJobs CalibrationJob[]

  @@index([requestId])
  @@index([deviceTypeId])
}

// =============================================================================
// Commercial & Work Order
// =============================================================================

model ServiceTariff {
  id        String   @id @default(cuid())
  companyId String
  code      String
  name      String
  unitPrice Decimal  @db.Decimal(18, 2)
  currency  String   @default("IDR")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items              QuotationItem[]
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([companyId, code])
}

/// Commercial price master — the DEFAULT tariff applied to a QuotationItem when a
/// Quotation is generated from a CalibrationRequest. Keyed by canonical
/// DeviceType (never customerDeviceName / DeviceTypeAlias / Device.id) and
/// company-scoped (same convention as ServiceTariff / Tax).
///
/// Append-only effective dating: a price change is a NEW row with a later
/// `effectiveFrom`, never an in-place edit of an active row. Lookup during
/// quotation generation selects the active row whose [effectiveFrom, effectiveUntil]
/// window contains the quotation date; that price is then SNAPSHOTTED into
/// QuotationItem.unitPrice and the Price List is never consulted again for that
/// quotation. Overlapping active windows for the same (companyId, deviceTypeId)
/// are rejected at the service layer.
model PriceListItem {
  id             String    @id @default(cuid())
  companyId      String
  deviceTypeId   String
  unitPrice      Decimal   @db.Decimal(18, 2)
  currency       String    @default("IDR")
  effectiveFrom  DateTime  @db.Date
  effectiveUntil DateTime? @db.Date
  isActive       Boolean   @default(true)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deviceType DeviceType @relation(fields: [deviceTypeId], references: [id])

  @@unique([companyId, deviceTypeId, effectiveFrom])
  @@index([companyId, deviceTypeId, effectiveFrom])
  @@index([companyId, isActive])
}

model Quotation {
  id                   String          @id @default(cuid())
  companyId            String
  customerId           String
  number               String
  requestId            String          @unique
  source               QuotationSource @default(PORTAL)
  status               QuotationStatus @default(DRAFT)
  validUntil           DateTime?
  subtotal             Decimal         @db.Decimal(18, 2)
  headerDiscountAmount Decimal         @default(0) @db.Decimal(18, 2)
  taxCode              String
  taxRate              Decimal         @db.Decimal(5, 4)
  taxAmount            Decimal         @db.Decimal(18, 2)
  totalAmount          Decimal         @db.Decimal(18, 2)
  currency             String          @default("IDR")
  approvedAt           DateTime?
  approvedByUserId     String?
  customerApprovedAt   DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  request        CalibrationRequest @relation(fields: [requestId], references: [id])
  items          QuotationItem[]
  purchaseOrders PurchaseOrder[]
  workOrders     WorkOrder[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([customerId])
  @@index([companyId, taxCode])
}

model QuotationItem {
  id             String   @id @default(cuid())
  companyId      String
  quotationId    String
  deviceId       String?
  requestItemId  String?
  tariffId       String?
  description    String
  qty            Decimal  @default(1) @db.Decimal(18, 4)
  unitPrice      Decimal  @db.Decimal(18, 2)
  discountAmount Decimal  @default(0) @db.Decimal(18, 2)
  lineTotal      Decimal  @db.Decimal(18, 2)
  /// True when quotation generation found no applicable PriceListItem for this
  /// line's DeviceType. unitPrice is stored as 0 and the Quotation cannot be
  /// sent/approved until a real price is entered (see QuotationsService.send).
  pricePending   Boolean  @default(false)
  createdAt      DateTime @default(now())

  quotation          Quotation               @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  device             Device?                 @relation(fields: [deviceId], references: [id])
  requestItem        CalibrationRequestItem? @relation(fields: [requestItemId], references: [id])
  tariff             ServiceTariff?          @relation(fields: [tariffId], references: [id])
  purchaseOrderItems PurchaseOrderItem[]

  @@index([quotationId])
}

model PurchaseOrder {
  id                   String              @id @default(cuid())
  companyId            String              @db.Char(3)
  customerId           String
  quotationId          String
  number               String
  customerPoNumber     String
  customerPoDate       DateTime
  status               PurchaseOrderStatus @default(DRAFT)
  subtotal             Decimal             @db.Decimal(18, 2)
  headerDiscountAmount Decimal             @default(0) @db.Decimal(18, 2)
  taxCode              String
  taxRate              Decimal             @db.Decimal(5, 4)
  taxAmount            Decimal             @db.Decimal(18, 2)
  totalAmount          Decimal             @db.Decimal(18, 2)
  currency             String              @default("IDR")
  receivedAt           DateTime?
  confirmedAt          DateTime?
  confirmedByUserId    String?
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  company    Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quotation  Quotation           @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  items      PurchaseOrderItem[]
  workOrders WorkOrder[]

  @@unique([companyId, number])
  @@unique([companyId, customerId, customerPoNumber])
  @@index([companyId, status])
  @@index([companyId, taxCode])
  @@index([quotationId])
}

model PurchaseOrderItem {
  id              String                  @id @default(cuid())
  companyId       String                  @db.Char(3)
  purchaseOrderId String
  quotationItemId String
  deviceId        String?
  tariffId        String?
  description     String
  qty             Decimal                 @default(1) @db.Decimal(18, 4)
  unitPrice       Decimal                 @db.Decimal(18, 2)
  discountAmount  Decimal                 @default(0) @db.Decimal(18, 2)
  lineTotal       Decimal                 @db.Decimal(18, 2)
  workOrderId     String?
  status          PurchaseOrderItemStatus @default(OPEN)
  createdAt       DateTime                @default(now())

  purchaseOrder   PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  quotationItem   QuotationItem    @relation(fields: [quotationItemId], references: [id], onDelete: Restrict)
  device          Device?          @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  tariff          ServiceTariff?   @relation(fields: [tariffId], references: [id], onDelete: SetNull)
  workOrder       WorkOrder?       @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  calibrationJobs CalibrationJob[]
  workOrderItems  WorkOrderItem[]

  @@unique([purchaseOrderId, quotationItemId])
  @@index([purchaseOrderId])
  @@index([workOrderId])
}

model WorkOrder {
  id                   String          @id @default(cuid())
  companyId            String
  quotationId          String
  purchaseOrderId      String
  customerId           String
  number               String
  serviceMode          ServiceMode
  addressText          String?
  geoLat               Float?
  geoLng               Float?
  locationNotes        String?
  scheduledStart       DateTime?
  scheduledEnd         DateTime?
  status               WorkOrderStatus @default(PLANNED)
  /// ON_SITE only: set when the planner confirms the reference-equipment list
  /// ("Equipment yang akan dibawa"). Cleared whenever that list is edited.
  /// Required before POST /work-orders/:id/start for ON_SITE work orders.
  /// Always null for SEND_TO_LAB.
  equipmentConfirmedAt DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  company            Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotation          Quotation              @relation(fields: [quotationId], references: [id])
  purchaseOrder      PurchaseOrder          @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  customer           Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items              WorkOrderItem[]
  assignments        WorkOrderAssignment[]
  jobs               CalibrationJob[]
  equipment          WorkOrderEquipment[]
  deliveryNote       EquipmentDeliveryNote?
  /// Legacy allocation pointer on PurchaseOrderItem. Unused by WorkOrder MVP.
  purchaseOrderItems PurchaseOrderItem[]
  /// Partial unique index `WorkOrder_purchaseOrderId_active_key` (status <> CANCELLED)
  /// is created in SQL. Prisma cannot model it; do not add @@unique([purchaseOrderId]).

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([quotationId])
  @@index([purchaseOrderId])
}

/// Operational snapshot of a PurchaseOrderItem. MVP copies every PO item 1:1.
/// Quantity and source identity are immutable after create.
model WorkOrderItem {
  id                  String   @id @default(cuid())
  companyId           String
  workOrderId         String
  purchaseOrderItemId String
  description         String
  qty                 Decimal  @default(1) @db.Decimal(18, 4)
  createdAt           DateTime @default(now())

  workOrder         WorkOrder         @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)

  @@unique([workOrderId, purchaseOrderItemId])
  @@index([workOrderId])
  @@index([purchaseOrderItemId])
}

model WorkOrderAssignment {
  id               String         @id @default(cuid())
  companyId        String
  workOrderId      String
  technicianUserId String
  roleOnJob        AssignmentRole @default(LEAD)
  createdAt        DateTime       @default(now())

  workOrder  WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  technician User      @relation(fields: [technicianUserId], references: [id])

  @@unique([workOrderId, technicianUserId])
  @@index([technicianUserId])
}

// Actual PKM reference-equipment units selected to be brought for a specific
// ON_SITE WorkOrder ("Equipment yang akan dibawa"). The DEFAULT proposal is
// DERIVED at read time from DeviceTypeEquipmentRequirement of the WorkOrder's
// calibration items (item -> purchaseOrderItem -> quotationItem -> requestItem
// -> deviceType), but once selected the list belongs to the WorkOrder and is
// independent of both DeviceTypeEquipmentRequirement and any future
// EquipmentDeliveryNote. SEND_TO_LAB WorkOrders never have rows here.
model WorkOrderEquipment {
  id              String   @id @default(cuid())
  companyId       String
  workOrderId     String
  equipmentId     String
  // Snapshot of the EquipmentType this row was selected to satisfy — kept so the
  // "which requirement does this cover" grouping survives if the Equipment unit
  // is later re-typed. Not a hard constraint target.
  equipmentTypeId String
  // Operational order within THIS WorkOrder's list (multiples of 10). Seeded from
  // the deduplicated DeviceTypeEquipmentRequirement order at proposal time; user
  // reorder persists here only — never on Equipment.
  sortOrder       Int      @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  @@unique([workOrderId, equipmentId])
  @@index([workOrderId])
  @@index([equipmentId])
  @@index([companyId])
}

// "Surat Jalan Alat" — the delivery note that accompanies the PKM reference
// equipment a technician carries to a customer site. ON_SITE work orders only
// (SEND_TO_LAB calibrates inside the PKM lab and needs no delivery note).
// Number is a DLN/YYYY/MM/NNNNN series allocated by DocumentNumberService,
// independent of SPK/WOL. Exactly one per work order (`workOrderId @unique`):
// issuance is idempotent and a reprint reuses the same number. Once created the
// header + its item snapshots are immutable — later edits to WorkOrderEquipment
// or the Equipment master never change an issued delivery note.
// ISSUED = active delivery note. CANCELLED = voided; historically preserved
// (number never reused, item snapshots intact) and still readable/printable, but
// no longer an active document. There is no normal-user CANCELLED -> ISSUED
// transition — voiding is a future controlled operation with audit logging.
enum EquipmentDeliveryNoteStatus {
  ISSUED
  CANCELLED
}

model EquipmentDeliveryNote {
  id              String                      @id @default(cuid())
  companyId       String
  workOrderId     String                      @unique
  number          String
  status          EquipmentDeliveryNoteStatus @default(ISSUED)
  // Business date the equipment leaves PKM — the scheduled on-site date when
  // known (WorkOrder.scheduledStart), else the issuance timestamp. Snapshotted.
  issuedAt        DateTime
  // Snapshots taken at issuance so the historical document is self-contained.
  workOrderNumber String
  customerName    String
  customerAddress String?
  locationText    String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  company   Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workOrder WorkOrder                   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  items     EquipmentDeliveryNoteItem[]

  @@unique([companyId, number])
  @@index([companyId])
}

// Immutable snapshot of one WorkOrderEquipment row at delivery-note issuance.
// `equipmentId` is a plain reference (no FK) — every field the PDF needs is
// copied here so the document never depends on mutable master data.
model EquipmentDeliveryNoteItem {
  id             String   @id @default(cuid())
  deliveryNoteId String
  equipmentId    String
  equipmentName  String
  brand          String?
  model          String?
  serialNumber   String?
  sortOrder      Int
  createdAt      DateTime @default(now())

  deliveryNote EquipmentDeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)

  @@index([deliveryNoteId])
}

// =============================================================================
// Field & QA
// =============================================================================

model CalibrationJob {
  id                       String  @id @default(cuid())
  companyId                String
  workOrderId              String
  purchaseOrderItemId      String?
  /// Physical Device master row, once a technician has verified identity on-site.
  /// NULLABLE: identity is normally unknown until on-site verification, and the
  /// WorkOrder proceeds to IN_PROGRESS regardless. A NULL deviceId is a normal
  /// pending state, not an error. Postgres treats NULLs as distinct, so many
  /// jobs with deviceId = NULL may coexist under one WorkOrder; the
  /// @@unique([workOrderId, deviceId]) constraint only binds once deviceId is set.
  deviceId                 String?
  /// Trace back to the original customer requisition line this job fulfils, so
  /// the customer's declaration (name / deviceId / akdAkl) stays reachable even
  /// though it is not copied forward through the commercial chain. Optional-FK
  /// pattern mirrors purchaseOrderItemId.
  calibrationRequestItemId String?

  // ── Unit fan-out ordinal ───────────────────────────────────────────────────
  /// Position of this job within the set of N jobs fanned out from a single
  /// WorkOrderItem (WorkOrderItem.qty = N). 1-based: the sole job of a qty-1
  /// line carries unitOrdinal = 1. Lets the technician UI label "unit 2 of 3"
  /// before any deviceId is matched, when sibling jobs are otherwise identical
  /// (same purchaseOrderItemId, deviceId = NULL, same declared name). Assigned
  /// by fan-out; never edited afterwards. No @default — fan-out must set it
  /// explicitly so a missing assignment fails loudly (and trips
  /// @@unique([workOrderId, purchaseOrderItemId, unitOrdinal])) rather than
  /// silently collapsing every unit to 1.
  unitOrdinal Int
  /// Snapshot of N (WorkOrderItem.qty, coerced to Int) at fan-out time — the
  /// denominator for "unit X of N". Frozen deliberately: if a sibling job is
  /// later cancelled/deleted, the declared unit count this calibration belongs
  /// to does not change.
  unitTotal   Int

  // ── Identity snapshot ──────────────────────────────────────────────────────
  // Frozen ON the job, not read through Device, so later edits to the mutable
  // Device master never rewrite what this calibration actually saw.
  /// Device name as the customer originally described it (snapshot of
  /// CalibrationRequestItem.customerDeviceName at job creation).
  customerDeclaredDeviceName String?
  /// AKD/AKL/NIE exactly as the customer declared it on the originating
  /// CalibrationRequestItem, snapshot at job creation (mirrors
  /// customerDeclaredDeviceName). NULLABLE: "customer did not declare one" is a
  /// valid state, not missing data. Frozen here so later edits to the mutable
  /// CalibrationRequestItem.akdAkl never rewrite what was on record when this
  /// job's akdAklApprovalStatus (TECHNICIAN_MANAGER) gate was decided.
  customerDeclaredAkdAkl     String?
  /// Serial number the technician physically read off the device on-site.
  technicianObservedSerial   String?
  /// AKD/AKL/NIE the technician physically observed / confirmed on-site.
  technicianObservedAkdAkl   String?

  // ── AKD/AKL/NIE approval gate ──────────────────────────────────────────────
  /// Manager decision state for this device's regulatory declaration.
  akdAklApprovalStatus   AkdAklApprovalStatus @default(NOT_REQUIRED)
  /// The TECHNICIAN_MANAGER who APPROVED/REJECTED. Set together with
  /// akdAklApprovalStatus + akdAklApprovedAt. (Role is enforced in the service
  /// layer, not by the schema.)
  akdAklApprovedByUserId String?
  akdAklApprovedAt       DateTime?
  /// Manager's rationale, especially for REJECTED / conditional APPROVED.
  akdAklDecisionNote     String?
  /// Provenance of the currently-open gate — see AkdAklGateOrigin. Set only
  /// while akdAklApprovalStatus = PENDING_REVIEW, NULL otherwise. Existing rows
  /// default to NULL (no backfill: a stale NOT_REQUIRED job has no open gate).
  akdAklGateOpenedBy     AkdAklGateOrigin?

  status      CalibrationJobStatus @default(PENDING)
  startedAt   DateTime?
  submittedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  workOrder              WorkOrder                   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  purchaseOrderItem      PurchaseOrderItem?          @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)
  device                 Device?                     @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  calibrationRequestItem CalibrationRequestItem?     @relation(fields: [calibrationRequestItemId], references: [id], onDelete: SetNull)
  akdAklApprovedBy       User?                       @relation("CalibrationJobAkdAklApprover", fields: [akdAklApprovedByUserId], references: [id])
  results                MeasurementResult[]
  evidences              JobEvidence[]
  referenceEquipmentUsed JobReferenceEquipmentUsed[]
  signature              CustomerSignature?
  reviews                QualityReview[]
  certificate            Certificate?
  identityCorrections    IdentityCorrection[]

  @@unique([workOrderId, deviceId])
  @@unique([workOrderId, purchaseOrderItemId, unitOrdinal])
  @@index([companyId, status])
  @@index([purchaseOrderItemId])
  @@index([calibrationRequestItemId])
  @@index([companyId, akdAklApprovalStatus])
  @@index([akdAklApprovedByUserId])
}

model MeasurementResult {
  id               String   @id @default(cuid())
  companyId        String
  calibrationJobId String
  payloadJson      Json
  summaryJson      Json?
  recordedAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  calibrationJob CalibrationJob @relation(fields: [calibrationJobId], references: [id], onDelete: Cascade)

  @@index([calibrationJobId])
}

model JobEvidence {
  id               String   @id @default(cuid())
  companyId        String
  calibrationJobId String
  fileObjectId     String
  caption          String?
  createdAt        DateTime @default(now())

  calibrationJob CalibrationJob @relation(fields: [calibrationJobId], references: [id], onDelete: Cascade)
  fileObject     FileObject     @relation(fields: [fileObjectId], references: [id])

  @@index([calibrationJobId])
}

model JobReferenceEquipmentUsed {
  id                           String  @id @default(cuid())
  companyId                    String
  calibrationJobId             String
  equipmentId                  String
  equipmentCalibrationRecordId String?
  notes                        String?

  // ── Validity override (TECHNICIAN_MANAGER force-accept path) ───────────────
  validityOverridden Boolean   @default(false)
  overrideReason     String?
  overriddenByUserId String?
  overriddenAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calibrationJob             CalibrationJob              @relation(fields: [calibrationJobId], references: [id], onDelete: Cascade)
  equipment                  Equipment                   @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  equipmentCalibrationRecord EquipmentCalibrationRecord? @relation(fields: [equipmentCalibrationRecordId], references: [id], onDelete: Restrict)
  overriddenBy               User?                       @relation("JobReferenceEquipmentOverrider", fields: [overriddenByUserId], references: [id])

  @@unique([calibrationJobId, equipmentId])
  @@index([companyId, equipmentId])
  @@index([equipmentCalibrationRecordId])
  @@index([overriddenByUserId])
}

model CustomerSignature {
  id               String   @id @default(cuid())
  companyId        String
  calibrationJobId String   @unique
  fileObjectId     String?
  signerName       String?
  signedAt         DateTime @default(now())
  createdAt        DateTime @default(now())

  calibrationJob CalibrationJob @relation(fields: [calibrationJobId], references: [id], onDelete: Cascade)
  fileObject     FileObject?    @relation(fields: [fileObjectId], references: [id])
}

// =============================================================================
// Identity Correction — Berita Acara Identitas for correcting a CalibrationJob's
// device identity (device_id / serial / AKD-AKL). Sole path for setting or
// changing CalibrationJob.deviceId going forward. Option A: flat header with
// prev*/new* column pairs for the 3 locked attributes. (Decisions 1-12)
// =============================================================================

model IdentityCorrection {
  id               String                   @id @default(cuid())
  companyId        String
  /// Job being corrected. Required FK, NOT unique — a job may accumulate many
  /// corrections over its life (audit). (Decision 1)
  calibrationJobId String
  /// BA number from DocumentNumberService (prefix "BAI"), unique per company.
  /// Named `number` (not `baNumber`) so readMaxExistingSequence's hardcoded
  /// "number" column applies. (Decision 9)
  number           String
  status           IdentityCorrectionStatus @default(PENDING_REVIEW)

  // ── Corrected attributes (all nullable — one BA may touch only some) ────────
  /// Device on the job before this correction. FK: Device is never deleted
  /// (project policy) so referential integrity holds. (Decision 4)
  prevDeviceId String?
  /// Device the correction resolves the job to. FK enables DeviceType-match
  /// validation + RI in the service layer. (Decision 4)
  newDeviceId  String?
  /// Plain snapshot strings, mirroring CalibrationJob.technicianObservedSerial
  /// / technicianObservedAkdAkl. (Decision 4)
  prevSerial   String?
  newSerial    String?
  prevAkdAkl   String?
  newAkdAkl    String?

  /// Why the correction is needed. Durable column — NEVER overwritten. (Decision 3)
  reason String

  /// Technician who initiated. Always known.
  submittedByUserId String

  // ── Manager decision (mirrors akdAklApprovedBy/At/note) ────────────────────
  decidedByUserId String?
  decidedAt       DateTime?
  decisionNote    String?

  /// True once an APPROVED correction that changed newAkdAkl has moved the
  /// job's akdAklApprovalStatus APPROVED -> PENDING_REVIEW. Audit clarity.
  /// (Decision 5)
  akdAklGateReopened Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calibrationJob CalibrationJob                @relation(fields: [calibrationJobId], references: [id], onDelete: Cascade)
  prevDevice     Device?                       @relation("IdentityCorrectionPrevDevice", fields: [prevDeviceId], references: [id], onDelete: Restrict)
  newDevice      Device?                       @relation("IdentityCorrectionNewDevice", fields: [newDeviceId], references: [id], onDelete: Restrict)
  submittedBy    User                          @relation("IdentityCorrectionSubmitter", fields: [submittedByUserId], references: [id])
  decidedBy      User?                         @relation("IdentityCorrectionDecider", fields: [decidedByUserId], references: [id])
  signatures     IdentityCorrectionSignature[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([calibrationJobId])
  @@index([submittedByUserId])
  @@index([decidedByUserId])
  @@index([prevDeviceId])
  @@index([newDeviceId])
}

model IdentityCorrectionSignature {
  id                   String                       @id @default(cuid())
  companyId            String
  /// FK, NOT unique — one TECHNICIAN row + one CUSTOMER row per correction.
  identityCorrectionId String
  signerRole           IdentityCorrectionSignerRole
  signerName           String?
  /// Signature image via FileOwnerType.IDENTITY_CORRECTION. Plain string, no
  /// FK relation — polymorphic like FileObject.ownerId; file-owner-policy
  /// wiring is a follow-up task. (Decision 10)
  fileObjectId         String?
  status               SignatureStatus              @default(SIGNED)
  /// Set when status = UNAVAILABLE/REFUSED. (Decision 7)
  unavailableReason    String?
  signedAt             DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  identityCorrection IdentityCorrection @relation(fields: [identityCorrectionId], references: [id], onDelete: Cascade)

  @@unique([identityCorrectionId, signerRole])
  @@index([companyId])
}

model QualityReview {
  id               String              @id @default(cuid())
  companyId        String
  calibrationJobId String
  reviewerUserId   String
  decision         ReviewDecision?
  status           QualityReviewStatus @default(PENDING)
  notes            String?
  reviewedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  calibrationJob CalibrationJob @relation(fields: [calibrationJobId], references: [id], onDelete: Cascade)
  reviewer       User           @relation("Reviewer", fields: [reviewerUserId], references: [id])
  certificates   Certificate[]

  @@index([calibrationJobId])
  @@index([companyId, status])
}

