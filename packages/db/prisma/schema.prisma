  totalAmount          Decimal             @db.Decimal(18, 2)
  currency             String
  receivedAt           DateTime?
  confirmedAt          DateTime?
  confirmedByUserId    String?
  notes                String?
  revisedByUserId      String?
  revisedAt            DateTime            @default(now())

  purchaseOrder PurchaseOrder              @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  revisedBy     User?                      @relation("PurchaseOrderHistoryRevisedBy", fields: [revisedByUserId], references: [id])
  items         PurchaseOrderItemHistory[]

  @@unique([purchaseOrderId, revisionNumber])
  @@index([purchaseOrderId])
}

/// Complete snapshot of one PurchaseOrderItem row. See
/// CalibrationRequestItemHistory for the `sourceItemId` contract.
model PurchaseOrderItemHistory {
  id              String                  @id @default(cuid())
  historyId       String
  sourceItemId    String
