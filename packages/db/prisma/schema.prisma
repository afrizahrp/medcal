// Real-time Web Chat conversation domain (separate from the Lead-intake
// domain below) — locked 2026-08-16 Web Chat correction audit + technical
// spike. A ChatSession's OPEN/CLOSED lifecycle is deliberately the only two
// states for MVP (no IDLE/EXPIRED/AUTO_CLOSED/ARCHIVED — no auto-close
// requirement exists yet).
enum ChatSessionStatus {
  OPEN
  CLOSED
}

// VISITOR = the anonymous visitor side of a ChatSession; ADMIN = a staff
// reply. No AI sender type — human-only chat is a locked product decision.
enum ChatSenderType {
  VISITOR
  ADMIN
}

enum FileOwnerType {
  CERTIFICATE
  JOB_EVIDENCE
  SIGNATURE
  REQUEST_ATTACHMENT
  INVOICE
  CREDIT_NOTE
  // Reference-equipment calibration certificate/evidence. ownerId =
  // EquipmentCalibrationRecord.id (that model is Phase 2B — not built yet).
  EQUIPMENT_CALIBRATION
  /// Signature image on an IdentityCorrectionSignature row. ownerId =
  /// IdentityCorrectionSignature.id. Deliberately NOT reusing SIGNATURE
  /// (which is CustomerSignature-on-job). (Decision 10)
  IDENTITY_CORRECTION
  /// Data-logger export (12-channel thermometer PDF/CSV) attached to a
  /// MeasurementResult LOGGER_SUMMARY row. ownerId = MeasurementResult.id.
  MEASUREMENT_RESULT
  OTHER
}

enum UomCategory {
  PRESSURE
  TEMPERATURE
  RATE
  FLOW
  PERCENTAGE
  LENGTH
  MASS
  VOLUME
  TIME
  ELECTRICAL
  OTHER
}

enum CalibrationValueType {
  NUMBER
  RATIO
  TEXT
  BOOLEAN
}

/// Catalog-level entry UI for a DeviceCalibrationParameter — which worksheet
/// shape the technician uses. Distinct from MeasurementEntryKind (that one
/// discriminates a stored MeasurementResult row). Pattern B setpoint grids
/// stay DIRECT_REPLICATES here and are excluded from Stage A by having
/// CalibrationTestPoint children. LOGGER_SUMMARY is the Pattern D fridge /
/// freezer / oven / sterilizer uniformity case (min/max + attachment; Stage C).
/// DERIVED (Phase 4B / Gap B) is a value the technician computes by hand from
/// other readings on the same worksheet (Autoclave ΔT, a magnification ratio)
/// and types in like any other reading — see `derivation` below. No formula is
/// ever executed by Medcal for this entry style.
enum CalibrationParameterEntryStyle {
  DIRECT_REPLICATES
  LOGGER_SUMMARY
  DERIVED
}

/// Ramp facet for Pattern D paired up/down sweeps (Suction Pump vacuum-gauge
/// accuracy "Naik | Turun"; Sphygmomanometer pressure accuracy "naik & turun").
/// NONE is the default and covers every non-ramp reading, so the value is always
/// non-null and can safely participate in the natural-key unique constraint
/// (a nullable column there would be defeated by Postgres NULL-distinctness).
enum MeasurementDirection {
  NONE
  UP // naik
  DOWN // turun
}

/// Discriminates a directly-typed reading from a summary row that stands in for
/// an attached data-logger export (Pattern D spatial/temporal uniformity — the
/// fridge / freezer / oven / sterilizer rows, where 9 sensors x 30 timepoints
/// are never typed into the worksheet). Drives Excel-export grouping.
enum MeasurementEntryKind {
  DIRECT_READING
  LOGGER_SUMMARY
}

/// Technician judgment for Physical Inspection (LK "Pemerikasaan Kondisi Fisik
/// dan Fungsi Komponen Alat"). Dedicated enum — not CalibrationValueType,
/// ReviewDecision, or a boolean Pass/Fail. No tolerance engine.
enum PhysicalCheckVerdict {
  BAIK
  TIDAK_BAIK
}

// Email → Lead Management (locked plan)
enum EmailFolder {
  INBOX
  SENT
  DRAFTS
  TRASH
}

enum EmailStatus {
  UNREAD
  READ
}

// =============================================================================
// Organization & IAM
// =============================================================================

model Company {
  id           String        @id @db.Char(3)
  name         String        @db.VarChar(50)
  legalName    String?       @db.VarChar(50)
  taxId        String?       @db.VarChar(25)
  address      String?       @db.VarChar(100)
  phone        String?       @db.VarChar(25)
  email        String?       @db.VarChar(50)
  status       CompanyStatus @default(ACTIVE)
  settingsJson Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  memberships                 UserMembership[]
  contactMessages             ContactMessage[]
  chatSessions                ChatSession[]
  leads                       Lead[]
  customers                   Customer[]
  devices                     Device[]
  equipment                   Equipment[]
  equipmentCalibrationRecords EquipmentCalibrationRecord[]
  calibrationRequests         CalibrationRequest[]
  serviceTariffs              ServiceTariff[]
  priceListItems              PriceListItem[]
  taxes                       Tax[]
  quotations                  Quotation[]
  purchaseOrders              PurchaseOrder[]
  workOrders                  WorkOrder[]
  certificates                Certificate[]
  invoices                    Invoice[]
  creditNotes                 CreditNote[]
  reminderEvents              ReminderEvent[]
  fileObjects                 FileObject[]
  fcmTokens                   FCMToken[]
  emails                      Email[]
  documentNumberSequences     DocumentNumberSequence[]
  workOrderEquipment          WorkOrderEquipment[]
  equipmentDeliveryNotes      EquipmentDeliveryNote[]
  auditLogs                   AuditLog[]
}

model DocumentNumberSequence {
  id           String       @id @default(cuid())
  companyId    String       @db.Char(3)
  documentType DocumentType
  prefix       String       @db.Char(3)
  year         Int
  lastSequence Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, documentType, year])
  @@index([companyId, documentType])
}

// Monotonic counters for auto-generated master business codes (Device
// Management Master Identity & Coding Standard). One row per scope:
// `"<ENTITY>#<companyId>"` for company-scoped entities (Device, Equipment),
// `"<ENTITY>"` for global ones. Allocated atomically by MasterCodeService via
// INSERT ... ON CONFLICT DO UPDATE ... RETURNING — never MAX(code)+1. Numbers
// are never reused; gaps (from rollback) are acceptable.
model MasterCodeSequence {
  id           String   @id @default(cuid())
  scope        String   @unique
  lastSequence Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique @db.VarChar(50)
  name          String?    @db.VarChar(50)
  status        UserStatus @default(INVITED)
  // Better Auth-owned bookkeeping fields (locked: no email verification step enforced,
  // but the column is part of Better Auth's own user-model contract).
  emailVerified Boolean    @default(false)
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  memberships                           UserMembership[]
  customerLinks                         CustomerUserLink[]
  fcmTokens                             FCMToken[]
  assignedLeads                         Lead[]                          @relation("LeadAssignee")
  confirmedMatches                      ContactMessage[]                @relation("MatchConfirmer")
  workOrderAssignments                  WorkOrderAssignment[]
  qualityReviews                        QualityReview[]                 @relation("Reviewer")
  sessions                              Session[]
  accounts                              Account[]
  emailWhitelistCreated                 EmailWhitelist[]                @relation("EmailWhitelistCreator")
  emailWhitelistRevoked                 EmailWhitelist[]                @relation("EmailWhitelistRevoker")
  menusCreated                          Menu[]                          @relation("MenuCreatedBy")
  menusUpdated                          Menu[]                          @relation("MenuUpdatedBy")
  sentEmails                            Email[]                         @relation("EmailSender")
  rolePermissionsCreated                RolePermission[]                @relation("RolePermissionCreatedBy")
  rolePermissionsUpdated                RolePermission[]                @relation("RolePermissionUpdatedBy")
  uploadedFiles                         FileObject[]                    @relation("FileUploadedBy")
  equipmentCalibrationsCreated          EquipmentCalibrationRecord[]    @relation("EquipmentCalibrationCreatedBy")
  equipmentCalibrationsAccepted         EquipmentCalibrationRecord[]    @relation("EquipmentCalibrationAcceptedBy")
  calibrationJobsAkdAklApproved         CalibrationJob[]                @relation("CalibrationJobAkdAklApprover")
  jobTestPointsExcluded                 JobCalibrationTestPoint[]       @relation("JobCalibrationTestPointExcludedBy")
  identityCorrectionsSubmitted          IdentityCorrection[]            @relation("IdentityCorrectionSubmitter")
  identityCorrectionsDecided            IdentityCorrection[]            @relation("IdentityCorrectionDecider")
  jobReferenceEquipmentUsagesOverridden JobReferenceEquipmentUsed[]     @relation("JobReferenceEquipmentOverrider")
  referenceEquipmentApprovalsSubmitted  JobReferenceEquipmentApproval[] @relation("JobReferenceEquipmentApprovalSubmitter")
  referenceEquipmentApprovalsDecided    JobReferenceEquipmentApproval[] @relation("JobReferenceEquipmentApprovalDecider")
  measurementResultsRecorded            MeasurementResult[]             @relation("MeasurementResultRecordedBy")
  physicalCheckResultsRecorded          PhysicalCheckResult[]           @relation("PhysicalCheckResultRecordedBy")
  workOrdersRequestReviewCompleted      WorkOrder[]                     @relation("WorkOrderRequestReviewCompletedBy")
  kontrolAlatsCreated                   KontrolAlat[]                   @relation("KontrolAlatCreatedBy")
  kontrolAlatSignatures                 KontrolAlatSignature[]          @relation("KontrolAlatSigner")
  calibrationRequestsCreated            CalibrationRequest[]            @relation("CalibrationRequestCreatedBy")
  calibrationRequestsUpdated            CalibrationRequest[]            @relation("CalibrationRequestUpdatedBy")
  certificatesCreated                   Certificate[]                   @relation("CertificateCreatedBy")
  certificatesUpdated                   Certificate[]                   @relation("CertificateUpdatedBy")
  invoicesCreated                       Invoice[]                       @relation("InvoiceCreatedBy")
  invoicesUpdated                       Invoice[]                       @relation("InvoiceUpdatedBy")
  paymentsCreated                       Payment[]                       @relation("PaymentCreatedBy")
  paymentsUpdated                       Payment[]                       @relation("PaymentUpdatedBy")
  quotationsApproved                    Quotation[]                     @relation("QuotationApprovedBy")
  purchaseOrdersConfirmed               PurchaseOrder[]                 @relation("PurchaseOrderConfirmedBy")
  auditLogs                             AuditLog[]
  lkDownloadAuthorizations              LkDownloadAuthorization[]
  // MOM #1 — Transaction Revision + Immutable History
  calibrationRequestRevisions           CalibrationRequestHistory[]     @relation("CalibrationRequestHistoryRevisedBy")
  quotationRevisions                    QuotationHistory[]              @relation("QuotationHistoryRevisedBy")
  purchaseOrderRevisions                PurchaseOrderHistory[]          @relation("PurchaseOrderHistoryRevisedBy")
  workOrderRevisions                    WorkOrderHistory[]              @relation("WorkOrderHistoryRevisedBy")
}

// =============================================================================
// Better Auth — owned tables (locked: hosted in-process inside apps/api;
// domain-facing User model above is reused as Better Auth's user model)
// =============================================================================

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

model UserMembership {
  id                   String         @id @default(cuid())
  userId               String
  companyId            String
  role                 MembershipRole
  isDefault            Boolean        @default(false)
  // Company-scoped push notification eligibility — NOT a permission/role grant.
  // When false, dispatch must not send FCM to this user for this company.
  receiveNotifications Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

// Menu Registry (locked 2026-08-19: DB-backed menu definitions, permission-
// derived visibility). Menu is navigation/config only — NOT a second
// authorization source. A leaf's viewResource/viewAction is looked up via the
// existing hasPermission(role, resource, action) catalog at read time; this
// model never stores role/permission grants itself. No companyId/branchId:
// company is deployment-scoped via COMPANY_ID, branch does not exist in this
// schema (see file header). Sibling `order` uniqueness within
// (application, parentId) is validated in the service layer, not here —
// Postgres treats NULL parentId values as distinct, which would defeat a
// root-level DB uniqueness constraint.
model Menu {
  id              String          @id @default(cuid())
  application     MenuApplication
  code            String
  parentId        String?
  label           String
  href            String?
  icon            String?
  order           Int             @default(0)
  isGroup         Boolean         @default(false)
  isActive        Boolean         @default(true)
  viewResource    String?
  viewAction      String?
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  parent    Menu?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children  Menu[] @relation("MenuHierarchy")
  createdBy User?  @relation("MenuCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy User?  @relation("MenuUpdatedBy", fields: [updatedByUserId], references: [id])

  @@unique([application, code])
  @@index([application, parentId])
}

// DB-driven Role -> Permission grants (locked 2026-08-20). Role/permission
// assignment is now data, not code: hasPermission(role, resource, action)
// reads from this table (via an in-memory cache) instead of a hardcoded
// per-role statement map. The set of valid (resource, action) pairs itself
// stays code-defined in packages/auth/src/access-control.ts's permission
// catalog — a pair is only meaningful once some route actually enforces it,
// so this table stores which roles hold which of those pairs, not the pairs
// themselves. SUPERADMIN intentionally has NO rows here: hasPermission
// hardcodes an unconditional bypass for SUPERADMIN so it can never be locked
// out via this table (including by mistake through the admin UI). No
// isActive flag — a missing row simply means "not granted". No
// companyId/branchId/applicationId, matching Menu's precedent: this
// deployment is company-scoped via COMPANY_ID, not per-row.
model RolePermission {
  id              String         @id @default(cuid())
  role            MembershipRole
  resource        String
  action          String
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  createdBy User? @relation("RolePermissionCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy User? @relation("RolePermissionUpdatedBy", fields: [updatedByUserId], references: [id])

  @@unique([role, resource, action])
  @@index([role])
}

// Registration gate (F4, locked): reusable, not consumed — a revoked row still
// exists but no longer authorizes sign-up. Standalone, no companyId.
// createdBy is nullable ONLY for the one-time SUPERADMIN bootstrap entry (see
// apps/api/src/bootstrap-superadmin.ts): NULL means "created by the bootstrap
// process, not by a user" — there is no admin yet at that point. Every entry
// created through the normal whitelist:manage flow (WhitelistService.create)
// always supplies a real createdBy and must continue to do so.
model EmailWhitelist {
  id        String               @id @default(cuid())
  email     String               @unique
  status    EmailWhitelistStatus @default(ACTIVE)
  createdBy String?
  createdAt DateTime             @default(now())
  revokedBy String?
  revokedAt DateTime?

  creator User? @relation("EmailWhitelistCreator", fields: [createdBy], references: [id])
  revoker User? @relation("EmailWhitelistRevoker", fields: [revokedBy], references: [id])

  @@index([status])
}

model CustomerUserLink {
  id         String   @id @default(cuid())
  userId     String
  customerId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([userId, customerId])
  @@index([customerId])
}

model FCMToken {
  id         String    @id @default(cuid())
  companyId  String
  userId     String
  token      String    @unique
  deviceType String
  app        PushApp
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId])
}

// =============================================================================
// Acquisition — ContactMessage (bi-erp) + Lead
// =============================================================================

model ContactMessage {
  id                String         @id @default(cuid())
  companyId         String
  getFrom           GetMessageFrom @default(CONTACTFORM)
  status            ContactStatus  @default(PENDING)
  subject           String?
  topicId           Int?
  message           String
  name              String
  email             String
  phone             String?
  // Canonical digit-only form of `phone` (see normalizePhone in @medcal/shared),
  // computed at write time — used for Lead identity matching (see Lead below),
  // kept separate from `phone` so the original submitted value is preserved.
  phoneNormalized   String?
  organizationName  String?
  utmJson           Json?
  matchStatus       MatchStatus    @default(NONE)
  matchedCustomerId String?
  confirmedByUserId String?
  confirmedAt       DateTime?
  leadId            String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  matchedCustomer Customer?     @relation("ContactMatchCandidate", fields: [matchedCustomerId], references: [id])
  lead            Lead?         @relation(fields: [leadId], references: [id])
  confirmedBy     User?         @relation("MatchConfirmer", fields: [confirmedByUserId], references: [id])
  topic           ContactTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  // Set when this ContactMessage is the one first-touch lead-intake record
  // created by a Web Chat ChatSession (see ChatSession.contactMessageId) —
  // null for every other channel (CONTACTFORM, WHATSAPP, EMAIL, etc.).
  chatSession     ChatSession?
  emails          Email[]

  @@index([companyId, createdAt])
  @@index([companyId, email])
  @@index([companyId, status])
  @@index([companyId, getFrom])
  @@index([leadId])
}

// Static, seeded lookup for Contact Form topic selection — global (no companyId),
// no admin CRUD by design (matches the reference implementation's own proportions).
model ContactTopic {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ContactMessage[]

  @@index([isActive])
}

// Unit of Measurement master data — global (no companyId) since UOMs are
// universal scientific standards (mmHg, °C, kPa, etc.) that don't vary by
// company. Admin CRUD enabled for extensibility, unlike ContactTopic.
model Uom {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  symbol    String
  category  UomCategory
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  calibrationParameters DeviceCalibrationParameter[]
  measurementResults    MeasurementResult[]

  @@index([category])
  @@index([isActive])
}

// Aggregate root over multiple channel interactions (Lead Inbox design review,
// 2026-08-16, Decision 1): one Lead may have many ContactMessage rows across
// different getFrom channels. name/email/phone/organizationName are a
// denormalized snapshot (Decision 2) populated from the first ContactMessage
// at Lead-creation time, used as the inbox list's display source of truth —
// ContactMessage rows remain the historical record of what was actually
// submitted on each interaction.
model Lead {
  id               String     @id @default(cuid())
  companyId        String
  status           LeadStatus @default(NEW)
  name             String
  email            String
  phone            String?
  organizationName String?
  assignedToUserId String?
  customerId       String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactMessages     ContactMessage[]
  assignedTo          User?                @relation("LeadAssignee", fields: [assignedToUserId], references: [id])
  customer            Customer?            @relation(fields: [customerId], references: [id])
  calibrationRequests CalibrationRequest[]
  suggestedInEmails   Email[]              @relation("EmailSuggestion")
  emails              Email[]              @relation("EmailAssociation")

  @@index([companyId, status])
  @@index([companyId, createdAt])
}

// Real-time Web Chat conversation domain (locked 2026-08-16, Web Chat
// correction audit + technical spike). Deliberately separate from the Lead
// domain above: a ChatSession creates AT MOST ONE ContactMessage (the
// first-touch lead-intake record, getFrom=CHAT_PERSON), never one per
// message — the full transcript lives in ChatMessage. contactMessageId is
// nullable (set once, right after the linked ContactMessage is created —
// see Phase 1's ChatSessionsService for the exact sequencing) and @unique
// so the database itself enforces "at most one ChatSession per
// ContactMessage" and, by the service never calling create twice per
// session, "at most one ContactMessage per ChatSession".
//
// No assignedToUserId — MVP is a shared inbox (no per-session ownership),
// matching Lead's own deferred assignment decision. No auto-close/expiry
// state — OPEN/CLOSED only.
model ChatSession {
  id                String            @id @default(cuid())
  companyId         String
  visitorName       String
  visitorEmail      String
  status            ChatSessionStatus @default(OPEN)
  contactMessageId  String?           @unique
  closedAt          DateTime?
  // Unread tracking (Management header notification audit, 2026-08-17):
  // null = admin has never read this session, or a VISITOR message has
  // arrived since the last time they did. Set only via the explicit
  // PATCH /chat-sessions/:id/read action (ChatSessionsService.markRead) —
  // mirrors ContactMessage's PENDING->READ convention (see
  // contact-messages-query.controller.ts) rather than inventing a new
  // unread mechanism. A session is "unread" when its latest VISITOR
  // ChatMessage.createdAt is newer than this timestamp (see
  // ChatSessionsService.countUnread) — deliberately NOT the same thing as
  // status=OPEN, which only tracks whether the conversation has ended.
  lastReadByAdminAt DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactMessage ContactMessage? @relation(fields: [contactMessageId], references: [id])
  messages       ChatMessage[]

  @@index([companyId, status])
  @@index([companyId, createdAt])
}

// One row per conversation turn (visitor or admin). `seq` is a
// table-wide monotonic counter (not reset per session) — sufficient for
// deterministic per-session ordering since every read is already scoped to
// one sessionId; a per-session counter would need its own transaction/lock
// machinery for no additional ordering guarantee this schema needs.
// `clientMessageId` + the compound unique index below is the
// duplicate-submission guard: a resend of the same client-generated id
// within the same session is rejected at the database level, not just
// application logic.
model ChatMessage {
  id              String         @id @default(cuid())
  companyId       String
  sessionId       String
  seq             Int            @default(autoincrement())
  senderType      ChatSenderType
  senderUserId    String?
  body            String
  clientMessageId String?
  createdAt       DateTime       @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, clientMessageId])
  @@index([sessionId, seq])
}

// Email → Lead Management (locked plan): single Email model for all folders.
// STRICT AUTO-SUGGEST ONLY: leadId is NEVER automatically set — always null
// until staff action. suggestedLeadId holds the system suggestion.
model Email {
  id        String @id @default(cuid())
  companyId String

  // IMAP deduplication — RFC Message-ID header
  messageId String? @unique

  // Sender/Recipients
  fromEmail String
  fromName  String?
  toEmail   String
  toName    String?
  ccEmail   String?
  bccEmail  String?

  // Content
  subject  String
  body     String  @db.Text
  textBody String? @db.Text

  // Mailbox state
  folder    EmailFolder @default(INBOX)
  status    EmailStatus @default(UNREAD)
  isStarred Boolean     @default(false)

  // Internal reply chain (MedCal cuid, NOT RFC header)
  parentEmailId String?

  // RFC metadata (for protocol behavior, NOT for internal threading)
  rfcInReplyTo  String? @db.Text
  rfcReferences String? @db.Text

  // Lead association - STRICT AUTO-SUGGEST
  suggestedLeadId String? // System suggestion only
  leadId          String? // Staff-confirmed only

  // ContactMessage link
  contactMessageId String?

  // Sender user (outbound)
  sentByUserId String?

  // Timestamps
  sentAt     DateTime?
  receivedAt DateTime?
  readAt     DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relations
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  suggestedLead  Lead?           @relation("EmailSuggestion", fields: [suggestedLeadId], references: [id], onDelete: SetNull)
  lead           Lead?           @relation("EmailAssociation", fields: [leadId], references: [id], onDelete: SetNull)
  contactMessage ContactMessage? @relation(fields: [contactMessageId], references: [id], onDelete: SetNull)
  sentBy         User?           @relation("EmailSender", fields: [sentByUserId], references: [id])
  parentEmail    Email?          @relation("EmailThread", fields: [parentEmailId], references: [id], onDelete: SetNull)
  replies        Email[]         @relation("EmailThread")

  @@index([companyId, folder])
  @@index([companyId, status])
  @@index([companyId, leadId])
  @@index([companyId, suggestedLeadId])
  @@index([companyId, createdAt])
  @@index([messageId])
  @@index([contactMessageId])
  @@index([parentEmailId])
}

model Customer {
  id        String         @id @default(cuid())
  companyId String
  number    String
  name      String
  legalName String?
  taxId     String?
  address   String?
  phone     String?
  mobile    String?
  email     String?
  status    CustomerStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts            CustomerContact[]
  userLinks           CustomerUserLink[]
  devices             Device[]
  leads               Lead[]
  matchedMessages     ContactMessage[]     @relation("ContactMatchCandidate")
  calibrationRequests CalibrationRequest[]
  quotations          Quotation[]
  purchaseOrders      PurchaseOrder[]
  workOrders          WorkOrder[]
  certificates        Certificate[]
  invoices            Invoice[]
  creditNotes         CreditNote[]
  reminderEvents      ReminderEvent[]
  fileObjects         FileObject[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, name])
}

model CustomerContact {
  id         String   @id @default(cuid())
  companyId  String
  customerId String
  name       String
  email      String?
  phone      String?
  title      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([companyId, email])
}

// =============================================================================
// Devices & Request
// =============================================================================

// Device taxonomy master data — global (no companyId), same convention as Uom.
// DeviceCategory is an internal domain grouping; DeviceType.name is the
// confirmed Kemenkes capability list (35 types). Device.deviceTypeId is the
// required FK to DeviceType; Device.category remains a free-text snapshot.
model DeviceCategory {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  types DeviceType[]

  @@index([isActive])
}

model DeviceType {
  id          String   @id @default(cuid())
  categoryId  String
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category                DeviceCategory                   @relation(fields: [categoryId], references: [id])
  devices                 Device[]
  calibrationParameters   DeviceCalibrationParameter[]
  physicalCheckItems      DevicePhysicalCheckItem[]
  capabilityOrders        DeviceTypeCapabilityOrder[]
  calibrationRequestItems CalibrationRequestItem[]
  equipmentRequirements   DeviceTypeEquipmentRequirement[]
  aliases                 DeviceTypeAlias[]
  priceListItems          PriceListItem[]

  @@index([categoryId])
  @@index([isActive])
}

// Customer-terminology synonyms for a DeviceType — global master (no companyId,
// mirroring DeviceType). Purpose: deterministic mapping of customer wording
// ("Tensimeter", "Blood Pressure Monitor") to the official MEDCAL DeviceType
// ("Sphygmomanometer") during Excel import matching. `alias` keeps the original
// text for display; `normalizedAlias` is the lowercased / trimmed /
// whitespace-collapsed matching key. The @@unique on normalizedAlias guarantees
// one alias resolves to AT MOST one DeviceType — ambiguity is impossible by
// construction, never resolved arbitrarily.
model DeviceTypeAlias {
  id              String   @id @default(cuid())
  deviceTypeId    String
  alias           String
  normalizedAlias String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deviceType DeviceType @relation(fields: [deviceTypeId], references: [id], onDelete: Cascade)

  @@unique([normalizedAlias])
  @@index([deviceTypeId])
  @@index([isActive])
}

// Calibration equipment / tools master — global (no companyId), same convention
// as Uom / DeviceCapability / DeviceCategory. This is the TYPE/CATEGORY of
// reference equipment (e.g. "Electrical Safety Analyzer"), NOT a physical
// instance — it deliberately has no serialNumber / assetTag / calibrationDueDate
// / status-of-a-unit / location / ownership fields. Those belong to the future
// physical Equipment instance layer (Phase 2 — see
// docs/claude/plans/device-management/equipment/implementation_report_equipment_audit.md).
// `category` is a free-text grouping hint (open business question in the audit —
// kept a nullable string rather than an enum until a controlled vocabulary is
// confirmed).
model EquipmentType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deviceRequirements DeviceTypeEquipmentRequirement[]
  equipment          Equipment[]

  @@index([isActive])
}

// Physical reference equipment — an INDIVIDUAL PKM-owned unit of an
// EquipmentType (e.g. "ESA-001", a Fluke ESA620 SN 12345). Company-scoped
// (companyId required), same convention as Device. `code` is the internal asset
// identity, unique per company. serialNumber is nullable and NOT unique (matches
// Device.serialNumber). Phase 2A is the master only: it deliberately carries NO
// calibration-validity / calibration-record / certificate / ownership / location
// / maintenance / inventory fields — current validity will be DERIVED from a
// future EquipmentCalibrationRecord[] (Phase 2B). See
// docs/claude/plans/device-management/equipment/implementation_report_equipment_phase2a_audit.md.
model Equipment {
  id              String   @id @default(cuid())
  companyId       String
  equipmentTypeId String
  code            String
  brand           String?
  model           String?
  serialNumber    String?
  isActive        Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  equipmentType EquipmentType @relation(fields: [equipmentTypeId], references: [id])

  calibrationRecords              EquipmentCalibrationRecord[]
  workOrderSelections             WorkOrderEquipment[]
  jobReferenceUsages              JobReferenceEquipmentUsed[]
  referenceEquipmentApprovalItems JobReferenceEquipmentApprovalItem[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@index([companyId, serialNumber])
  @@index([equipmentTypeId])
}

// Phase 2B lifecycle status. DRAFT = evidence being entered, freely editable /
// deletable. CONFIRMED = historical evidence, locked against normal editing and
// deletion; attached FileObjects become immutable via the EQUIPMENT_CALIBRATION
// FileOwnerPolicy. Corrections after CONFIRMED = a new record, never an edit.
enum EquipmentCalibrationRecordStatus {
  DRAFT
  CONFIRMED
}

// One historical calibration event of a physical Equipment unit. Append-only:
// current calibration validity is DERIVED from these records for a reference
// date (validityservice) — there is deliberately NO Equipment.calibrationDueDate
// / Equipment.calibrationStatus source-of-truth field. `result` is the lab's
// outcome (free text — controlled vocabulary is an OPEN business decision, see
// implementation_report_equipment_phase2b.md); `acceptedForUse` is MEDCAL's
// separate acceptance decision and is NOT auto-derived from `result`. Supporting
// certificate PDFs attach through the generic FilesModule
// (FileObject.ownerType = EQUIPMENT_CALIBRATION, ownerId = this record's id) —
// no typed relation because FileObject.ownerId is polymorphic.
model EquipmentCalibrationRecord {
  id                String                           @id @default(cuid())
  companyId         String
  equipmentId       String
  calibrationDate   DateTime                         @db.Date
  validFrom         DateTime?                        @db.Date
  validUntil        DateTime                         @db.Date
  certificateNumber String?
  provider          String?
  result            String?
  remarks           String?
  acceptedForUse    Boolean                          @default(false)
  acceptedByUserId  String?
  acceptedAt        DateTime?
  acceptanceNotes   String?
  status            EquipmentCalibrationRecordStatus @default(DRAFT)
  createdByUserId   String?
  createdAt         DateTime                         @default(now())
  updatedAt         DateTime                         @updatedAt

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  equipment  Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  acceptedBy User?     @relation("EquipmentCalibrationAcceptedBy", fields: [acceptedByUserId], references: [id])
  createdBy  User?     @relation("EquipmentCalibrationCreatedBy", fields: [createdByUserId], references: [id])

  jobReferenceUsages              JobReferenceEquipmentUsed[]
  referenceEquipmentApprovalItems JobReferenceEquipmentApprovalItem[]

  @@index([equipmentId, calibrationDate])
  @@index([equipmentId, validUntil])
  @@index([companyId, status])
}

// "Required Equipment" — declares that calibrating a given DeviceType normally
// requires a given EquipmentType. Master configuration only: it is NOT an
// assignment, NOT a per-job snapshot, and carries no quantity / mandatory-flag /
// priority / lifecycle (all deferred — see the audit's open questions). The
// required set for a CalibrationJob is derived at read time from
// job.device.deviceTypeId, never copied onto WorkOrder / CalibrationJob.
model DeviceTypeEquipmentRequirement {
  id              String   @id @default(cuid())
  deviceTypeId    String
  equipmentTypeId String
  notes           String?
  // Operational order of this equipment within its parent DeviceType on the
  // Equipment Requirements screen and the future generated calibration
  // worksheet ("A. Daftar Alat yang Digunakan"). The order is business data,
  // not presentation — it belongs on this DeviceType x EquipmentType
  // relationship, never on the reusable EquipmentType master. Written in a
  // single transactional pass (multiples of 10); reads tie-break on equipment
  // type name for determinism. Existing rows are seeded per-DeviceType from
  // row-creation order by the add_equipment_requirement_sort_order migration.
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deviceType    DeviceType    @relation(fields: [deviceTypeId], references: [id])
  equipmentType EquipmentType @relation(fields: [equipmentTypeId], references: [id])

  @@unique([deviceTypeId, equipmentTypeId])
  @@index([deviceTypeId])
  @@index([equipmentTypeId])
}

// Manufacturer/brand master — independent master (global, no companyId), same
// convention as DeviceType/DeviceCategory. `code` is system-issued (MFR-000001),
// immutable, and never derived from `name`.
model DeviceManufacturer {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  models DeviceModel[]

  @@index([isActive])
}

// Product/model master — independent of DeviceType (locked business rule,
// 2026-09-21 refactor): DeviceModel belongs ONLY to DeviceManufacturer.
// Unique per (manufacturerId, model); the same model name may exist under a
// different manufacturer, but not twice under the same one. `code` is
// system-issued (MOD-000001), immutable, and never derived from `model`.
// Do not FK DeviceType or Device to this model.
model DeviceModel {
  id             String   @id @default(cuid())
  code           String   @unique
  manufacturerId String
  model          String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  manufacturer DeviceManufacturer @relation(fields: [manufacturerId], references: [id])

  @@unique([manufacturerId, model])
  @@index([manufacturerId])
  @@index([isActive])
}

// Device function/capability master — global (no companyId), same convention
// as Uom/DeviceCategory. DeviceCapabilityItem is a child of a capability
// (e.g. NIBP → Systolic/Diastolic/MAP). DeviceCalibrationParameter is a
// master definition of what is measured/assessed during calibration, unique
// per (deviceTypeId, capabilityItemId, code). Do not FK DeviceModel or Device
// to these models this phase.
model DeviceCapability {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items            DeviceCapabilityItem[]
  deviceTypeOrders DeviceTypeCapabilityOrder[]

  @@index([isActive])
}

// Internal taxonomy leaf: groups DeviceCalibrationParameters under a
// DeviceCapability (e.g. NIBP -> Systolic / Diastolic / MAP). No business
// identity — identified by `id` and `name` only; deliberately has no `code`.
model DeviceCapabilityItem {
  id           String   @id @default(cuid())
  capabilityId String
  name         String
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  capability            DeviceCapability             @relation(fields: [capabilityId], references: [id])
  calibrationParameters DeviceCalibrationParameter[]

  @@unique([capabilityId, name])
  @@index([capabilityId])
  @@index([isActive])
}

// Master definition of a calibration measurement parameter for a DeviceType,
// under a DeviceCapabilityItem. valueType declares the kind of value the
// parameter expects; uom is required in meaning for NUMBER, optional for
// RATIO/TEXT/BOOLEAN. toleranceMin/toleranceMax store the comparable
// acceptance bounds (nullable for upper-bound-only or unresolved cases);
// toleranceNote keeps the verbatim LK wording. Unique per
// (deviceTypeId, capabilityItemId, code).
model DeviceCalibrationParameter {
  id                     String                         @id @default(cuid())
  deviceTypeId           String
  capabilityItemId       String
  code                   String
  name                   String
  description            String?
  valueType              CalibrationValueType           @default(NUMBER)
  uomId                  String?
  toleranceMin           Decimal?                       @db.Decimal(18, 4)
  toleranceMax           Decimal?                       @db.Decimal(18, 4)
  /// Whether `toleranceMin` is inclusive (≥). False means strict (>).
  /// Ignored when `toleranceMin` is NULL. Default true keeps every pre-existing
  /// row on the inclusive comparison the evaluator used before this column.
  toleranceMinInclusive  Boolean                        @default(true)
  /// Whether `toleranceMax` is inclusive (≤). False means strict (<).
  /// Ignored when `toleranceMax` is NULL. Default true is the historical behavior.
  toleranceMaxInclusive  Boolean                        @default(true)
  toleranceNote          String?
  // Digits after the decimal point required for this parameter's measured
  // calibration result. Only meaningful for valueType = NUMBER; NULL for
  // RATIO/TEXT/BOOLEAN. Existing NUMBER rows were backfilled with a uniform
  // safe default of 0 (accurate per-parameter values are a separate follow-up).
  // A CHECK constraint bounds it to 0..10 (see migrations).
  decimalPlaces          Int?
  // Display order of this parameter within its (deviceTypeId, capability) scope
  // on the calibration-parameter screen and the future generated worksheet.
  // Written in a single transactional pass (multiples of 10); reads tie-break
  // on `name`. Existing rows are seeded by backfill-calibration-ordering.ts.
  sortOrder              Int                            @default(0)
  isActive               Boolean                        @default(true)
  /// Which entry UI this catalog row needs. Default DIRECT_REPLICATES covers
  /// Pattern A (+ Pattern C-as-A) and Pattern B (which still uses typed
  /// readings; the grid is expressed by CalibrationTestPoint children).
  /// LOGGER_SUMMARY is backfilled for the 9 storage-temperature uniformity
  /// codes in CalibrationTestPoint_Seed_Extraction.md §6.4.
  entryStyle             CalibrationParameterEntryStyle @default(DIRECT_REPLICATES)
  /// Tech-PWA repetition UX (2026-09-20). Catalog-level signal for whether the
  /// "+ Tambah ulangan" control should be offered for this parameter's
  /// applicable measurement points (Pattern A rows, or each named
  /// CalibrationTestPoint in Pattern B). Presentation only — replicateIndex,
  /// the natural key, and every persisted reading are unaffected either way;
  /// this never hides or removes existing MeasurementResult rows, it only
  /// controls whether the technician can grow the slot count further.
  /// Default true preserves today's behavior for every existing parameter.
  allowsRepeatedReadings Boolean                        @default(true)
  /// Phase 4A (Gap A) — CATALOG / PRESENTATION metadata only.
  ///
  /// Several LK worksheets record more than one independently measured quantity
  /// for a single logical test: one Dental X-Ray exposure yields kV, s and mGy;
  /// one microscope magnification yields a stage and an eyepiece reading. Each
  /// quantity keeps its own unit, decimalPlaces, tolerance and verdict, so each
  /// stays its OWN parameter row (the same split already used for
  /// _KANAN/_KIRI and _ON/_OFF). These two columns are the only thing that says
  /// "these rows are one logical test, printed in this order".
  ///
  /// This is NOT part of measurement identity: MeasurementResult's natural key,
  /// CalibrationTestPoint, JobCalibrationTestPoint and replicateIndex are all
  /// unchanged. Grouping is never inferred from `code` or `name`.
  ///
  /// Both NULL (the default, and every pre-existing row) = a standalone
  /// parameter that behaves exactly as before. Both must be set together, and
  /// `(deviceTypeId, logicalTestKey, logicalTestSequence)` is unique so two
  /// parameters can never claim the same column of the same logical test
  /// (see migrations for the paired-NULL and >= 1 CHECK constraints).
  logicalTestKey         String?
  logicalTestSequence    Int?
  /// Phase 4B (Gap B) — DESCRIPTIVE ONLY. Only meaningful when
  /// `entryStyle = DERIVED`. Documents in structured but non-executable form
  /// what this value is derived from (e.g. `{ "description": "Difference
  /// between S1 and S3" }`), for the technician and the reviewer to read. It is
  /// NEVER parsed as a formula, NEVER evaluated, and NEVER drives an automatic
  /// calculation — the technician still types the derived value into an
  /// ordinary MeasurementResult, exactly like every other reading. NULL for
  /// every non-DERIVED row and for every pre-existing row.
  derivation             Json?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  deviceType     DeviceType           @relation(fields: [deviceTypeId], references: [id])
  capabilityItem DeviceCapabilityItem @relation(fields: [capabilityItemId], references: [id])
  uom            Uom?                 @relation(fields: [uomId], references: [id])

  testPoints         CalibrationTestPoint[]
  measurementResults MeasurementResult[]
  jobTestPoints      JobCalibrationTestPoint[]

  @@unique([deviceTypeId, capabilityItemId, code])
  // One column position per logical test, per device type. NULLs are DISTINCT in
  // Postgres, so every ungrouped (legacy) row is exempt.
  @@unique([deviceTypeId, logicalTestKey, logicalTestSequence])
  @@index([deviceTypeId])
  @@index([capabilityItemId])
  @@index([uomId])
  @@index([isActive])
  @@index([deviceTypeId, logicalTestKey])
}

// Per-DeviceType ordering of DeviceCapabilities on the calibration-parameter
// screen and (future) generated worksheet. A DeviceCapability is a shared
// global master reused across many DeviceTypes, so its display order cannot
// live on the master — it belongs on this DeviceType x Capability relationship.
// `sortOrder` is an integer written in a single transactional pass (multiples
// of 10); reads tie-break on capability name for determinism.
model DeviceTypeCapabilityOrder {
  id           String   @id @default(cuid())
  deviceTypeId String
  capabilityId String
  sortOrder    Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  deviceType DeviceType       @relation(fields: [deviceTypeId], references: [id], onDelete: Cascade)
  capability DeviceCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([deviceTypeId, capabilityId])
  @@index([deviceTypeId])
}

/// Per-DeviceType Physical Inspection catalog item. Covers physical condition,
/// component condition, and observable function checks as ONE domain (LK
/// "Pemerikasaan Kondisi Fisik dan Fungsi Komponen Alat"). Global master — no
/// companyId, no inheritance, no capabilityItemId / UoM / tolerance. A DeviceType
/// with zero items is valid. inspectionLimit is the LK "Batas Pemeriksaan" prose,
/// not a numeric tolerance.
model DevicePhysicalCheckItem {
  id              String   @id @default(cuid())
  deviceTypeId    String
  code            String
  name            String
  inspectionLimit String
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deviceType DeviceType            @relation(fields: [deviceTypeId], references: [id])
  results    PhysicalCheckResult[]

  @@unique([deviceTypeId, code])
  @@index([deviceTypeId])
  @@index([isActive])
}

model Device {
  id           String       @id @default(cuid())
  companyId    String
  // Auto-generated, immutable business code (DVC-000001), unique per company.
  // Issued by MasterCodeService on create; never user-supplied or editable.
  code         String
  customerId   String
  deviceTypeId String
  brand        String?
  model        String?
  serialNumber String?
  category     String?
  locationText String?
  status       DeviceStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deviceType DeviceType @relation(fields: [deviceTypeId], references: [id])

  calibrationRequestItems CalibrationRequestItem[]
  quotationItems          QuotationItem[]
  purchaseOrderItems      PurchaseOrderItem[]
  calibrationJobs         CalibrationJob[]
  certificates            Certificate[]
  identityCorrectionsPrev IdentityCorrection[]     @relation("IdentityCorrectionPrevDevice")
  identityCorrectionsNew  IdentityCorrection[]     @relation("IdentityCorrectionNewDevice")

  @@unique([companyId, code])
  @@index([companyId, customerId])
  @@index([companyId, serialNumber])
  @@index([deviceTypeId])
}

model CalibrationRequest {
  id          String      @id @default(cuid())
  companyId   String
  customerId  String
  number      String
  leadId      String?
  serviceMode ServiceMode

  /// The date expected/requested by the customer for calibration service.
  /// This is the canonical scheduling field for CalibrationRequest.
  expectedDate DateTime? @db.Date

  /// @deprecated Use `expectedDate` instead.
  /// This field is retained for backward compatibility with existing data.
  /// Do not use in new code. Will be removed in a future cleanup revision.
  desiredScheduleNote String?

  status          CalibrationRequestStatus @default(DRAFT)
  notes           String?
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead      Lead?    @relation(fields: [leadId], references: [id])
  createdBy User?    @relation("CalibrationRequestCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy User?    @relation("CalibrationRequestUpdatedBy", fields: [updatedByUserId], references: [id])

  items     CalibrationRequestItem[]
  quotation Quotation?
  // MOM #1 — Transaction Revision + Immutable History
  history   CalibrationRequestHistory[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([customerId])
  @@index([createdByUserId])
  @@index([updatedByUserId])
}

model CalibrationRequestItem {
  id                 String            @id @default(cuid())
  companyId          String
  requestId          String
  deviceTypeId       String
  /// Customer's original terminology / name for the equipment, preserved verbatim
  /// (e.g. "Tensimeter Digital" while the mapped DeviceType is "Sphygmomanometer").
  /// Nullable: not always captured for manual / legacy rows.
  customerDeviceName String?
  /// Customer-provided equipment model designation, if available (free-text).
  /// Not a relation to any Model master.
  model              String?
  /// REQUIRED FK to the Device master record (Device.id). The customer's
  /// "Serial No" (manual entry or Excel import column) is a LOOKUP KEY only —
  /// it is resolved server-side against an existing Device (scoped to this
  /// request's customer) and the resolved Device.id is what is stored here.
  /// Never the raw Serial No text, never a fabricated/auto-created Device.
  /// This is the real system identity and is preserved verbatim through
  /// QuotationItem.deviceId / PurchaseOrderItem.deviceId / (qty=1)
  /// CalibrationJob.deviceId. It is distinct from the technician's later
  /// on-site physical observation (CalibrationJob.technicianObserved*),
  /// which remains a separate, independent snapshot.
  deviceId           String
  /// Aggregate quantity for this line — how many physical units of this
  /// device the customer is requesting. Excel import keeps one row per
  /// spreadsheet line and stores its Qty here (it is NOT split into N rows).
  /// Manual "+ Requisition" entry creates one row per device, so qty stays 1.
  /// A CHECK constraint enforces qty >= 1 (see migration).
  qty                Int               @default(1)
  /// Customer-declared AKD/AKL/NIE (Nomor Izin Edar) for this device, verbatim
  /// and free-text. Intentionally NULLABLE — the customer often does not know it
  /// at Requisition stage. This is a declaration only, NOT technical
  /// verification; the authoritative value is captured later on CalibrationJob.
  /// Never store a placeholder ("-" / "N/A"); use `akdAklDeclaration` to record
  /// "customer says there is none".
  akdAkl             String?
  /// Provenance of `akdAkl` — see the AkdAklDeclaration enum.
  akdAklDeclaration  AkdAklDeclaration @default(NOT_PROVIDED)
  notes              String?
  /// MOM #1 — Revision Scope Design. true = active (part of the requisition's
  /// current desired scope); false = retired by a revision that removed this
  /// line after a downstream Quotation had already been generated from it
  /// (see mom-1-final-revision-scope-design-20260920.md §6). A row with no
  /// downstream QuotationItem is hard-deleted on removal instead — this flag
  /// only ever becomes false for an already-consumed row, never deleted.
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())

  request         CalibrationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  deviceType      DeviceType         @relation(fields: [deviceTypeId], references: [id])
  device          Device             @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  quotationItems  QuotationItem[]
  calibrationJobs CalibrationJob[]

  @@index([requestId])
  @@index([deviceTypeId])
  @@index([deviceId])
}

