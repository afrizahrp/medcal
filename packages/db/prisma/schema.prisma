  purchaseOrder   PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  quotationItem   QuotationItem    @relation(fields: [quotationItemId], references: [id], onDelete: Restrict)
  device          Device?          @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  tariff          ServiceTariff?   @relation(fields: [tariffId], references: [id], onDelete: SetNull)
  workOrder       WorkOrder?       @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  calibrationJobs CalibrationJob[]
  workOrderItems  WorkOrderItem[]

  @@unique([purchaseOrderId, quotationItemId])
  @@index([purchaseOrderId])
  @@index([workOrderId])
}

model WorkOrder {
  id                   String          @id @default(cuid())
  companyId            String
  quotationId          String
  purchaseOrderId      String
  customerId           String
  number               String
  serviceMode          ServiceMode
  addressText          String?
  geoLat               Float?
  geoLng               Float?
  locationNotes        String?
  scheduledStart       DateTime?
  scheduledEnd         DateTime?
  status               WorkOrderStatus @default(PLANNED)
  /// ON_SITE only: set when the planner confirms the reference-equipment list
  /// ("Equipment yang akan dibawa"). Cleared whenever that list is edited.
  /// Required before POST /work-orders/:id/start for ON_SITE work orders.
  /// Always null for SEND_TO_LAB.
  equipmentConfirmedAt DateTime?

  // ── Customer request review (F.MU.08 II — Kaji Ulang Permintaan Pelanggan) ─
  // Owned on WorkOrder so one customer/work event (one WOL) shares the same
  // review across all sibling CalibrationJobs. Meaningful for SEND_TO_LAB only;
  // ON_SITE stays null / false defaults. Not a hard gate for job.start().
  requestReviewMethodOk          Boolean?
  requestReviewEquipmentOk       Boolean?
  requestReviewPersonnelOk       Boolean?
  requestReviewConfirmAgree      Boolean   @default(false)
  requestReviewConfirmEmail      Boolean   @default(false)
  requestReviewConfirmLetter     Boolean   @default(false)
  requestReviewConfirmOther      Boolean   @default(false)
  requestReviewConfirmOtherText  String?
  requestReviewCompletedAt       DateTime?
  requestReviewCompletedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company                  Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotation                Quotation              @relation(fields: [quotationId], references: [id])
  purchaseOrder            PurchaseOrder          @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  customer                 Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  requestReviewCompletedBy User?                  @relation("WorkOrderRequestReviewCompletedBy", fields: [requestReviewCompletedByUserId], references: [id])
  items                    WorkOrderItem[]
  assignments              WorkOrderAssignment[]
  jobs                     CalibrationJob[]
  equipment                WorkOrderEquipment[]
  deliveryNote             EquipmentDeliveryNote?
  /// Legacy allocation pointer on PurchaseOrderItem. Unused by WorkOrder MVP.
  purchaseOrderItems       PurchaseOrderItem[]
  /// Partial unique index `WorkOrder_purchaseOrderId_active_key` (status <> CANCELLED)
  /// is created in SQL. Prisma cannot model it; do not add @@unique([purchaseOrderId]).
  // MOM #1 — Transaction Revision + Immutable History
  history                  WorkOrderHistory[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([quotationId])
  @@index([purchaseOrderId])
  @@index([requestReviewCompletedByUserId])
}

/// Operational snapshot of a PurchaseOrderItem. MVP copies every PO item 1:1.
/// Quantity and source identity are immutable after create.
model WorkOrderItem {
  id                  String   @id @default(cuid())
  companyId           String
  workOrderId         String
  purchaseOrderItemId String
  description         String
  qty                 Decimal  @default(1) @db.Decimal(18, 4)
  createdAt           DateTime @default(now())

  workOrder         WorkOrder                @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem        @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  accessories       WorkOrderItemAccessory[]

  @@unique([workOrderId, purchaseOrderItemId])
  @@index([workOrderId])
  @@index([purchaseOrderItemId])
}

/// Initial UUT accessory / perlengkapan list entered manually on the Work Order
/// (F.MU.07). Copied into KontrolAlatAccessory when a SEND_TO_LAB KontrolAlat is
/// created. Not a master/template catalog. Not WorkOrderEquipment (ON_SITE
/// reference gear).
model WorkOrderItemAccessory {
  id              String   @id @default(cuid())
  workOrderItemId String
  label           String
  sortOrder       Int
  createdAt       DateTime @default(now())

  workOrderItem WorkOrderItem @relation(fields: [workOrderItemId], references: [id], onDelete: Cascade)

  @@index([workOrderItemId])
}

// =============================================================================
// MOM #1 — Transaction Revision + Immutable History
//
// Append-only, full-snapshot history for the REQ -> QUOTATION -> PO -> WOL/SPK
// chain (see docs/minutes-of-meeting/mom-1-*.md). Operational tables above stay
// the source of current state; a revision mutates them in place (or adds an
// additive sibling item row where a downstream snapshot already exists — see
// mom-1-item-revision-rule) and INSERTs one header + N item history rows first.
// History rows are INSERT-only: no service method may UPDATE or DELETE them.
// Customer-facing `number` never changes across revisions.
// =============================================================================

/// Complete snapshot of a CalibrationRequest header immediately before a
/// revision was applied. One row per revision; `revisionNumber` is 1-based and
/// allocated as MAX(revisionNumber)+1 inside the same transaction that updates
/// the current CalibrationRequest row (see CalibrationRequestsService.revise).
model CalibrationRequestHistory {
  id              String                   @id @default(cuid())
  requestId       String
  revisionNumber  Int
  companyId       String
  customerId      String
  number          String
  leadId          String?
  serviceMode     ServiceMode
  expectedDate    DateTime?                @db.Date
  status          CalibrationRequestStatus
  notes           String?
  revisedByUserId String?
  revisedAt       DateTime                 @default(now())

  request   CalibrationRequest              @relation(fields: [requestId], references: [id], onDelete: Cascade)
  revisedBy User?                           @relation("CalibrationRequestHistoryRevisedBy", fields: [revisedByUserId], references: [id])
  items     CalibrationRequestItemHistory[]

  @@unique([requestId, revisionNumber])
  @@index([requestId])
}

/// Complete snapshot of one CalibrationRequestItem row as it stood at the
/// moment of the parent CalibrationRequestHistory revision. `sourceItemId`
/// points at the live CalibrationRequestItem.id this snapshot was taken from
/// (not a foreign key — the source row may itself later change or, in
/// principle, be superseded; the snapshot must remain readable regardless).
model CalibrationRequestItemHistory {
  id                 String            @id @default(cuid())
  historyId          String
  sourceItemId       String
  deviceTypeId       String
  customerDeviceName String?
  model              String?
  deviceId           String?
  qty                Int
  akdAkl             String?
  akdAklDeclaration  AkdAklDeclaration
  notes              String?

  history CalibrationRequestHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)

  @@index([historyId])
}

/// Complete snapshot of a Quotation header immediately before a revision was
/// applied. See CalibrationRequestHistory for the revision-numbering contract.
model QuotationHistory {
  id                   String          @id @default(cuid())
  quotationId          String
  revisionNumber       Int
  companyId            String
  customerId           String
  number               String
  requestId            String
  source               QuotationSource
  status               QuotationStatus
  validUntil           DateTime?
  subtotal             Decimal         @db.Decimal(18, 2)
  headerDiscountAmount Decimal         @db.Decimal(18, 2)
  taxCode              String
  taxRate              Decimal         @db.Decimal(5, 4)
  taxAmount            Decimal         @db.Decimal(18, 2)
  totalAmount          Decimal         @db.Decimal(18, 2)
  currency             String
  approvedAt           DateTime?
  approvedByUserId     String?
  customerApprovedAt   DateTime?
  revisedByUserId      String?
  revisedAt            DateTime        @default(now())

  quotation Quotation              @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  revisedBy User?                  @relation("QuotationHistoryRevisedBy", fields: [revisedByUserId], references: [id])
  items     QuotationItemHistory[]

  @@unique([quotationId, revisionNumber])
  @@index([quotationId])
}

/// Complete snapshot of one QuotationItem row. See
/// CalibrationRequestItemHistory for the `sourceItemId` contract.
model QuotationItemHistory {
  id             String  @id @default(cuid())
  historyId      String
  sourceItemId   String
  deviceId       String?
  requestItemId  String?
  tariffId       String?
  description    String
  qty            Decimal @db.Decimal(18, 4)
  unitPrice      Decimal @db.Decimal(18, 2)
  discountAmount Decimal @db.Decimal(18, 2)
  lineTotal      Decimal @db.Decimal(18, 2)
