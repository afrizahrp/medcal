  history QuotationHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)

  @@index([historyId])
}

/// Complete snapshot of a PurchaseOrder header immediately before a revision
/// was applied. See CalibrationRequestHistory for the revision-numbering
/// contract.
model PurchaseOrderHistory {
  id                   String              @id @default(cuid())
  purchaseOrderId      String
  revisionNumber       Int
  companyId            String
  customerId           String
  quotationId          String
