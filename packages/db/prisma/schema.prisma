  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  certificate Certificate? @relation(fields: [certificateId], references: [id])

  @@index([invoiceId])
}

model Payment {
  id        String        @id @default(cuid())
  companyId String
  invoiceId String
  amount    Decimal       @db.Decimal(18, 2)
  method    PaymentMethod @default(TRANSFER)
  paidAt    DateTime      @default(now())
  reference String?
  notes     String?
  createdAt DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([companyId, paidAt])
}

model CreditNote {
  id            String           @id @default(cuid())
  companyId     String
  customerId    String
  invoiceId     String?
  certificateId String?
  number        String
  status        CreditNoteStatus @default(DRAFT)
  amount        Decimal          @db.Decimal(18, 2)
  reason        String
  issuedAt      DateTime?
  appliedAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id])
  certificate Certificate? @relation(fields: [certificateId], references: [id])

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([invoiceId])
}

// =============================================================================
// Retain & Vault
// =============================================================================

model ReminderEvent {
  id            String              @id @default(cuid())
  companyId     String
  certificateId String
  customerId    String
  channel       ReminderChannel
  status        ReminderEventStatus @default(SCHEDULED)
  scheduledFor  DateTime
  sentAt        DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([companyId, status, scheduledFor])
  @@index([certificateId])
}

model FileObject {
  id               String        @id @default(cuid())
  companyId        String
  customerId       String?
  ownerType        FileOwnerType
  ownerId          String
  storageKey       String
  mimeType         String?
  sizeBytes        Int?
  originalName     String?
  // sha256 hex digest of the stored binary — integrity, restore verification,
  // dedupe check. Nullable only to stay additive over the pre-existing (unused)
  // schema; the FilesModule always sets it on upload.
  checksum         String?
  // Who provided this evidence. Nullable for system-generated files.
  uploadedByUserId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer        Customer?           @relation(fields: [customerId], references: [id])
  uploadedByUser  User?               @relation("FileUploadedBy", fields: [uploadedByUserId], references: [id])
  jobEvidences    JobEvidence[]
  signatures      CustomerSignature[]
  certificatePdfs Certificate[]       @relation("CertificatePdf")

  @@unique([storageKey])
  @@index([companyId, ownerType, ownerId])
  @@index([uploadedByUserId])
}
