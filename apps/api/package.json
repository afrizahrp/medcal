{
  "name": "@medcal/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "bootstrap:superadmin": "tsx --env-file=../../.env src/bootstrap-superadmin.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"lint api skipped\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@medcal/auth": "workspace:*",
    "@medcal/config": "workspace:*",
    "@medcal/db": "workspace:*",
    "@medcal/notifications": "workspace:*",
    "@medcal/shared": "workspace:*",
    "@nestjs/common": "^11.0.12",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "@thallesp/nestjs-better-auth": "^2.7.0",
    "better-auth": "^1.6.27",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@medcal/typescript-config": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10"
  }
}
