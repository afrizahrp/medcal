{
  "name": "@medcal/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "bootstrap:superadmin": "tsx --env-file=../../.env src/bootstrap-superadmin.ts",
    "template:requisition": "tsx src/generate-requisition-template.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"lint api skipped\"",
    "pretest": "pnpm --filter @medcal/db run prepare-test-db",
    "test": "vitest run"
  },
  "dependencies": {
    "@medcal/auth": "workspace:*",
    "@medcal/config": "workspace:*",
    "@medcal/db": "workspace:*",
    "@medcal/notifications": "workspace:*",
    "@medcal/shared": "workspace:*",
    "@nestjs/common": "^11.0.12",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/platform-socket.io": "^11.0.12",
    "@nestjs/websockets": "^11.0.12",
    "@thallesp/nestjs-better-auth": "^2.7.0",
    "better-auth": "^1.6.27",
    "exceljs": "^4.4.0",
    "imap": "^0.8.19",
    "mailparser": "^3.7.2",
    "pdfkit": "^0.20.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@medcal/typescript-config": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/imap": "^0.8.42",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.13.10",
    "@types/pdfkit": "^0.17.6",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10"
  }
}
